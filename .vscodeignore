.vscode/**
.vscode-test/**
src/**
test/**
scripts/**
# The packaged readme is generated by scripts/package.ts (out/readme.vsix.md,
# images inlined) and passed to vsce as --readme-path; the repository README.md
# must not ship beside it, or the two collide as readme.md/README.md on
# case-insensitive file systems.
README.md
out/**
dist/**/*.map
.gitignore
.yarnrc
esbuild.js
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
# The extension is bundled into dist/extension.js by esbuild, so the production
# dependency tree does not need to ship — except for serialport, which is
# deliberately left external (see esbuild.js: node-gyp-build resolves its
# native .node binary relative to __dirname at runtime, so bundling it breaks
# every serial tool).
#
# This allow-list is serialport's full transitive closure, derived from the
# installed tree rather than guessed. Regenerate after a serialport upgrade:
#
#   node -e "const s=new Set();(function w(p){if(s.has(p))return;s.add(p);
#     let j;try{j=require('./node_modules/'+p+'/package.json')}catch(e){return}
#     for(const d of Object.keys(j.dependencies||{}))w(d)})('serialport');
#     console.log([...s].sort().join('\n'))"
#
# Getting this wrong fails at runtime in the packaged extension only — never in
# development, where the whole tree is present. test/transport/packaged-vsix.js
# unpacks the built VSIX and loads serialport from it, which is what catches it.
node_modules/**
!node_modules/serialport/**
!node_modules/@serialport/**
!node_modules/node-addon-api/**
!node_modules/node-gyp-build/**
!node_modules/debug/**
!node_modules/ms/**
coverage/**
.qlty/**
# Local agent settings of a working copy (git ignores them only through a user's global ignore file).
.claude/**
.github/**
.npmrc
# pdf.js runs on a worker thread of its own (dist/pdfWorker.js, the library
# bundled in) and loads its "fake worker" from this file there.
!node_modules/pdfjs-dist/package.json
!node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs
# Design notes and licence inputs stay in the repo; only docs/agent-resources is read at runtime (MCP resources).
docs/**
!docs/agent-resources/**

# Only the installed help skill and its catalog ship. Procedure sources are
# authored in cmsis-knowledge-base/sources/cda-procedures (skills/README.md).
skills/**
!skills/catalog.json
!skills/cmsis-help/**

# personal scratch notes
notes.md
# Build output of the knowledge index (2.7 line); never shipped.
graphify-out/**
# README images: the packaged readme (out/readme.vsix.md) inlines them as data URIs.
assets/architecture.png
assets/architecture.mmd
docs/cmsis-developer-assistant.png
docs/ai-development-lifecycle.png
# Local state of other developer tools in the checkout; never shipped.
.embedder/**

%% Architecture of the CMSIS Developer Assistant 2.7.
%% Export to assets/architecture.png (used by the user guide) after editing:
%%   npm run diagram
%% (mermaid-cli with the local Chrome; opaque background so the extension page renders it in dark themes too).
flowchart LR
    accTitle: CMSIS Developer Assistant 2.7 architecture
    accDescr: MCP calls are routed to the workspace's VS Code window. Each window provides debugging, documentation and build information, and an always-on knowledge system. Knowledge tools and the Knowledge Browser share read-only core, pack and workspace indexes; the active target scopes knowledge_search and optionally browser searches.
    agent["AI coding agent<br/>(MCP client)"]
    agent -- "MCP over HTTP<br/>localhost:3001" --> srvA

    subgraph router["VS Code window A — router"]
        direction TB
        srvA["MCP server"]
        srvA -- "runs the tool locally" --> dbgA["Debug pipeline"]
        srvA -- "documentation tools" --> docsA["Pack docs"]
        srvA -- "knowledge tools" --> knowledgeA["Knowledge"]
    end

    srvA -- "forwards the tool call<br/>127.0.0.1 + token" --> srvB

    subgraph worker["VS Code window B — worker"]
        direction TB
        srvB["Control server"]
        srvB --> dbgB["Debug pipeline"]
        srvB --> docsB["Pack docs"]
        srvB --> knowledgeB["Knowledge"]
    end

    subgraph pipeline["Debug pipeline (per window)"]
        direction TB
        api["vscode.debug API"] --> cdt["CDT GDB Debug Adapter<br/>(gdbtarget)"]
        cdt --> gdb["arm-none-eabi-gdb"]
        gdb --> server["pyOCD / J-Link GDB Server"]
        server -- "SWD / JTAG" --> target["Cortex-M target"]
        api -.-> svd["SVD parser"]
    end

    subgraph docs["Documentation retrieval (per window)"]
        direction TB
        store["Page store<br/>(page text + BM25 index,<br/>extension global storage)"]
        extract["pdf.js (bundled) /<br/>pdftotext"] --> store
        packs["DFP / BSP PDFs<br/>(CMSIS_PACK_ROOT)"] --> extract
        user["User documents folder ·<br/>workspace docs/<br/>(sensor and ADC datasheets)"] --> extract
        web["developer.arm.com ·<br/>PDF URLs (fetch_doc)"] --> extract
        store --> search["search_target_docs ·<br/>read_doc_pages ·<br/>get_peripheral_docs"]
        svdDocs["Device / core SVD"] -.-> search
        build["ELF · linker map · build log<br/>(build-artefact tools)"]
    end

    subgraph knowledge["Knowledge system (per window)"]
        direction TB
        coreIndex["Bundled core index<br/>resources/knowledge/core.db"]
        packIndexes["Pack indexes<br/>.knowledge/knowledge.db"]
        workspaceIndex["Workspace index<br/>.cmsis/knowledge.db"]
        coreIndex & packIndexes & workspaceIndex --> indexes[("Read-only SQLite index set<br/>Procedures · rules · concepts<br/>Troubleshooting · assets")]
        indexes --> engine["Knowledge engine<br/>Search · units · graph"]
        context["Active target context<br/>Board · device · packs · compiler"] -. "scopes knowledge_search" .-> engine
        knowledgeTools["knowledge_search<br/>knowledge_get · knowledge_expand"] --> engine
        browser["Knowledge Browser<br/>Read-only VS Code panel"] --> engine
    end

    dbgA -.-> pipeline
    dbgB -.-> pipeline
    docsA -.-> docs
    docsB -.-> docs
    knowledgeA -.-> knowledge
    knowledgeB -.-> knowledge

    style knowledge fill:#f0f8f5,stroke:#77a793
    classDef knowledgeNode fill:#e2f2eb,stroke:#77a793,color:#183d30
    class knowledgeA,knowledgeB,coreIndex,packIndexes,workspaceIndex,indexes,engine,context,knowledgeTools,browser knowledgeNode

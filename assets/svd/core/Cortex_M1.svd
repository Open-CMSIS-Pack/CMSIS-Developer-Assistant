          <access>read-only</access>
          <fields>
            <field>
              <name>EIASAMPLE</name>
              <description>Sampled instruction address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>COMP%s</name>
          <description>Comparator Register n: the address (or data value / cycle count) that comparator n matches against, as configured in FUNCTIONn.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>

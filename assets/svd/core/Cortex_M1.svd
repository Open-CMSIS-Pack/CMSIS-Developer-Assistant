            <field>
              <name>KEY</name>
              <description>Write 1 to enable writes to BP_CTRL; reads as zero.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NUM_CODE</name>
              <description>Number of breakpoint comparators implemented (0 to 4).</description>

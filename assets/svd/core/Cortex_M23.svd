                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DebugEvent</name>
                  <description>Watchpoint debug event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trace</name>
                  <description>Data trace packet</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TraceTrigger</name>
                  <description>Trace and trigger</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATAVSIZE</name>
              <description>Size of the data value to match: 0 = byte, 1 = halfword, 2 = word.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>MATCHED</name>
              <description>The comparator matched since this register was last read. Cleared on read.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ID</name>
              <description>Read-only capability ID of this comparator: which MATCH types (cycle counter, instruction address, data address, data value, linked/limit) it supports - see the DWT_FUNCTION.ID table in the ARMv8-M ARM.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

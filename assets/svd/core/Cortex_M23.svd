              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>COMP0</name>
          <description>Comparator Register 0</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>COMP</name>
              <description>Reference value for the comparator: an address, a data value (DATAVMATCH / MATCH = data value) or a cycle count.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FUNCTION0</name>
          <description>Function Register 0</description>
          <addressOffset>0x028</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>MATCH</name>
              <description>ARMv8-M match type: 0 disabled, 1 cycle counter (comparator 0), 2 instruction address, 3 instruction address limit (with the previous comparator forms a range), 4 data address, 5 data address limit, 6 data address with data value (linked to the next comparator), 7 data address limit with value, 8 data value, 9 data address linked (for the value in the next comparator), 10 data address with value linked, 11-15 further data-value/range combinations. See the ARMv8-M ARM DWT_FUNCTION table and ID for what this comparator supports.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ACTION</name>
              <description>Action on match: 0 = trigger only (CMPMATCH to ETM/CTI), 1 = debug event (halt, or DebugMonitor), 2 = data trace packet (address/PC/value), 3 = both trace and trigger.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>

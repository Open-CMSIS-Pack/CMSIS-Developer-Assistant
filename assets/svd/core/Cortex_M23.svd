    <peripheral>
      <name>FPB</name>
      <description>Flash Patch and Breakpoint unit (FPBv2): up to eight instruction address comparators for hardware breakpoints (halfword granular) and, if RMPSPT is set, literal comparators for remapping code-space loads.</description>
      <baseAddress>0xE0002000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x028</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFBC</offset>
        <size>0x044</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FP_CTRL</name>
          <description>Flash Patch Control Register: enable, and the number of comparators implemented. Writes must set KEY.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Flash Patch unit enable: 1 = breakpoint and remap comparators active. Reset value 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>KEY</name>
              <description>Write 1 to enable writes to FP_CTRL; reads as zero. A write with KEY = 0 is ignored.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NUM_CODE</name>
              <description>Number of instruction address comparators, bits [3:0] (with NUM_CODE_HI). Reads as zero if there are none.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>NUM_LIT</name>
              <description>Number of literal (data) address comparators; these are the last NUM_LIT comparators.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>NUM_CODE_HI</name>
              <description>Number of instruction address comparators, bits [6:4].</description>
              <bitOffset>12</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>REV</name>
              <description>Flash Patch and Breakpoint unit architecture revision: 0 = FPBv1 (ARMv7-M), 1 = FPBv2 (ARMv8-M).</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FP_REMAP</name>
          <description>Flash Patch Remap Register: base address of the remap table when remapping is supported (RMPSPT); reserved otherwise.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>REMAP</name>
              <description>Bits [28:5] of the remap base address (SRAM region).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>RMPSPT</name>
              <description>Remap supported: 1 = the FPB supports flash patch remapping, 0 = breakpoints only (typical on Cortex-M23/M33/M55/M85).</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>FP_COMP%s</name>
          <description>Flash Patch Comparator Register n: halfword-aligned instruction address to break on. Any address is allowed (not only the code region).</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>BE</name>
              <description>Breakpoint enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BPADDR</name>
              <description>Bits [31:1] of the instruction address to match.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVARCH</name>
          <description>Device Architecture Register: the architecture of the component (CoreSight ARCHID) and its architect.</description>
          <addressOffset>0xFBC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ARCHID</name>
              <description>Architecture ID, including the architecture part number [11:0] and revision [15:12].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect (Arm: 0x23B).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: major and sub type of the CoreSight component.</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 miscellaneous, 1 trace sink, 2 trace link, 3 trace source, 4 debug control, 5 debug logic, 6 PMU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type within the major class.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SysTick</name>
      <description>24-bit system timer that counts down from LOAD to 0 on the processor or reference clock and can raise the SysTick exception; the usual RTOS tick source. Banked per security state on ARMv8-M with the Security Extension.</description>
      <baseAddress>0xE000E010</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x010</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>SysTick Control and Status Register: enable, interrupt enable, clock source and the sticky count-to-zero flag.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Counter enable: 1 = SysTick counts down from LOAD to 0 and reloads.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TICKINT</name>
              <description>1 = counting down to 0 sets the SysTick exception pending; 0 = poll COUNTFLAG instead.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLKSOURCE</name>
              <description>Clock source: 0 = external reference clock (implementation defined, e.g. HCLK/8), 1 = processor clock.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>External</name>
                  <description>External reference clock (implementation defined)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Processor</name>
                  <description>Processor clock</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>COUNTFLAG</name>
              <description>Reads 1 if the counter reached 0 since the last read of this register. Cleared by reading CTRL or writing VAL.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LOAD</name>
          <description>SysTick Reload Value Register: value loaded into VAL when the counter reaches 0. A period of N clocks needs RELOAD = N-1.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>RELOAD</name>
              <description>Value loaded into VAL when the counter reaches 0. A period of N clocks needs RELOAD = N-1; 0 is legal but the counter then never fires.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>VAL</name>
          <description>SysTick Current Value Register: the current count. Any write clears it to 0 and clears CTRL.COUNTFLAG; the next reload comes from LOAD.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CURRENT</name>
              <description>Current counter value. Any write clears the field to 0 and clears CTRL.COUNTFLAG.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CALIB</name>
          <description>SysTick Calibration Register: implementation-defined reload value for a 10 ms tick and whether a reference clock exists.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TENMS</name>
              <description>Reload value for a 10 ms period with the reference clock, or 0 if unknown. Implementation defined.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>SKEW</name>
              <description>1 = TENMS is not exact (a 10 ms tick cannot be produced exactly).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NOREF</name>
              <description>1 = no separate reference clock: CLKSOURCE reads 1 and cannot be cleared.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>NVIC</name>
      <description>Nested Vectored Interrupt Controller: enable, pending, active and priority registers for the external interrupts (IRQ0 = exception 16) and the software trigger register. Bit k of register n refers to IRQ 32n+k.</description>
      <baseAddress>0xE000E100</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x4F0</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ISER%s</name>
          <description>Interrupt Set-Enable Register n (IRQ 32n..32n+31): write 1 to enable an interrupt, 0 has no effect; reads the enable state.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SETENA</name>
              <description>Bit k: write 1 to enable IRQ 32n+k; reads 1 if enabled. Writing 0 has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ICER%s</name>
          <description>Interrupt Clear-Enable Register n (IRQ 32n..32n+31): write 1 to disable an interrupt, 0 has no effect; reads the enable state.</description>
          <addressOffset>0x080</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLRENA</name>
              <description>Bit k: write 1 to disable IRQ 32n+k; reads 1 if enabled. Writing 0 has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ISPR%s</name>
          <description>Interrupt Set-Pending Register n (IRQ 32n..32n+31): write 1 to set an interrupt pending; reads the pending state.</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SETPEND</name>
              <description>Bit k: write 1 to set IRQ 32n+k pending; reads 1 if pending.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ICPR%s</name>
          <description>Interrupt Clear-Pending Register n (IRQ 32n..32n+31): write 1 to clear a pending interrupt; reads the pending state.</description>
          <addressOffset>0x180</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLRPEND</name>
              <description>Bit k: write 1 to clear IRQ 32n+k pending; reads 1 if pending.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>IABR%s</name>
          <description>Interrupt Active Bit Register n (IRQ 32n..32n+31): 1 = the interrupt handler is active (executing or preempted). Read-only.</description>
          <addressOffset>0x200</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ACTIVE</name>
              <description>Bit k: 1 = the handler of IRQ 32n+k is active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ITNS%s</name>
          <description>Interrupt Target Non-secure Register n (Security Extension): 1 = IRQ 32n+k targets Non-secure state. Secure access only; RAZ/WI from Non-secure.</description>
          <addressOffset>0x280</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ITNS</name>
              <description>Bit k: 1 = IRQ 32n+k targets Non-secure state, 0 = Secure.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>124</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>IPR%s</name>
          <description>Interrupt Priority Register n: one byte per interrupt, IRQ 4n+0 in bits [7:0] up to IRQ 4n+3 in [31:24]. Lower value = higher priority; only the top nvicPrioBits of each byte are implemented (ARMv6-M: 2, typical ARMv7-M: 3-4).</description>
          <addressOffset>0x300</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_N0</name>
              <description>Priority of interrupt 4n+0. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_N1</name>
              <description>Priority of interrupt 4n+1. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_N2</name>
              <description>Priority of interrupt 4n+2. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_N3</name>
              <description>Priority of interrupt 4n+3. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCB</name>
      <description>System Control Block: CPUID, exception control and state (ICSR, AIRCR, SHCSR), system configuration (SCR, CCR), system handler priorities, the fault status and address registers (CFSR, HFSR, DFSR, MMFAR, BFAR), CPU feature IDs, coprocessor access control, and on cores with caches the cache ID and maintenance registers.</description>
      <baseAddress>0xE000ED00</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x028</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CPUID</name>
          <description>CPUID Base Register: implementer, part number, architecture and revision of the processor (read-only).</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>REVISION</name>
              <description>Minor revision pM of the rNpM product revision.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PARTNO</name>
              <description>Part number: 0xC20 Cortex-M0, 0xC60 Cortex-M0+, 0xC21 Cortex-M1, 0xC23 Cortex-M3, 0xC24 Cortex-M4, 0xC27 Cortex-M7, 0xD20 Cortex-M23, 0xD21 Cortex-M33, 0xD31 Cortex-M35P, 0xD22 Cortex-M55, 0xD23 Cortex-M85, 0xD24 Cortex-M52.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>ARCHITECTURE</name>
              <description>Architecture: 0xC = ARMv6-M, 0xF = ARMv7-M or ARMv8-M (use ID_PFR/ID_ISAR for the details).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>VARIANT</name>
              <description>Major revision rN of the rNpM product revision.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>IMPLEMENTER</name>
              <description>Implementer code: 0x41 = Arm.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ICSR</name>
          <description>Interrupt Control and State Register: active and pending exception numbers, and set/clear-pending controls for NMI, PendSV and SysTick.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VECTACTIVE</name>
              <description>Exception number of the currently executing handler; 0 in Thread mode. 2 NMI, 3 HardFault, 4 MemManage, 5 BusFault, 6 UsageFault, 7 SecureFault, 11 SVCall, 12 DebugMonitor, 14 PendSV, 15 SysTick, 16+n IRQn.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RETTOBASE</name>
              <description>1 = the current handler is the only active exception (an exception return would go to Thread mode); 0 = another exception is preempted.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>VECTPENDING</name>
              <description>Exception number of the highest-priority pending enabled exception, 0 if none. Not affected by PRIMASK/FAULTMASK/BASEPRI.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ISRPENDING</name>
              <description>1 = an external interrupt (IRQ, not NMI or a fault) is pending.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ISRPREEMPT</name>
              <description>1 = a pending exception will be serviced when the processor leaves Debug state (debug use only).</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>STTNS</name>
              <description>SysTick Targets Non-secure (Security Extension, single-SysTick implementations): 1 = the SysTick exception targets Non-secure state. Secure write only.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDSTCLR</name>
              <description>Write 1 to clear a pending SysTick exception. Reads as 0.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PENDSTSET</name>
              <description>Write 1 to set the SysTick exception pending; reads 1 while it is pending.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDSVCLR</name>
              <description>Write 1 to clear a pending PendSV. Reads as 0.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PENDSVSET</name>
              <description>Write 1 to set PendSV pending (the usual RTOS context-switch trigger); reads 1 while it is pending.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDNMICLR</name>
              <description>Write 1 to clear a pending NMI (ARMv8-M; Secure or debugger access only). Reads as 0.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PENDNMISET</name>
              <description>Write 1 to set NMI pending; NMI is taken at once unless another NMI is active or the processor is halted. Reads 1 while pending. Secure or debugger access only when BFHFNMINS = 0.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>VTOR</name>
          <description>Vector Table Offset Register: base address of the exception vector table. Must be aligned to the table size rounded up to a power of two (at least 128 bytes). Reset value is implementation defined (usually 0; set by SystemInit when the table is relocated).</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TBLOFF</name>
              <description>Vector table base address. The table must be aligned to its size rounded up to a power of two (at least 128 bytes; the low bits read as zero).</description>
              <bitOffset>7</bitOffset>
              <bitWidth>25</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AIRCR</name>
          <description>Application Interrupt and Reset Control Register: priority grouping, endianness, system reset request and (ARMv8-M) security attribution of BusFault/HardFault/NMI. Writes must place 0x05FA in VECTKEY or are ignored.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <resetValue>0xFA050000</resetValue>
          <fields>
            <field>
              <name>VECTCLRACTIVE</name>
              <description>Debug use only: write 1 (with VECTKEY) to clear all active-exception state. Only while halted; otherwise unpredictable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSRESETREQ</name>
              <description>Write 1 (with VECTKEY = 0x05FA) to request a system reset (asserts SYSRESETREQ to the reset controller). Self-clearing; NVIC_SystemReset() uses this.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSRESETREQS</name>
              <description>System reset request Secure only (Security Extension): 1 = only Secure software or the debugger can set SYSRESETREQ.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BFHFNMINS</name>
              <description>BusFault, HardFault and NMI Non-secure (Security Extension): 1 = these exceptions target Non-secure state and Secure faults escalate to the Non-secure HardFault. 0 = they target Secure state.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRIS</name>
              <description>Prioritize Secure exceptions (Security Extension): 1 = Non-secure exception priorities are mapped to the lower half of the range, so any Secure exception can preempt them.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENDIANNESS</name>
              <description>Data endianness: 0 = little-endian, 1 = big-endian (BE8). Read-only, sampled at reset.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Little</name>
                  <description>Little-endian data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Big</name>
                  <description>Big-endian (BE8) data</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VECTKEY</name>
              <description>Register key: writes must contain 0x05FA here or the whole write is ignored. Reads as 0xFA05 (VECTKEYSTAT).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SCR</name>
          <description>System Control Register: sleep-on-exit, deep sleep selection and send-event-on-pending.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SLEEPONEXIT</name>
              <description>1 = the processor sleeps (as after WFI) whenever it returns from an exception handler to Thread mode. Interrupt-driven designs run entirely from handlers this way.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPDEEP</name>
              <description>1 = WFI, WFE and sleep-on-exit request deep sleep (SLEEPDEEP output; the implementation-defined low-power mode, often stopping clocks/PLL) instead of sleep.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPDEEPS</name>
              <description>Sleep Deep Secure only (Security Extension): 1 = SLEEPDEEP can only be written from Secure state.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SEVONPEND</name>
              <description>Send Event on Pending: 1 = an interrupt becoming pending (even a disabled one) wakes the processor from WFE, enabling the WFE-polling idle pattern.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CCR</name>
          <description>Configuration and Control Register: trapping of divide-by-zero and unaligned accesses, stack alignment, unprivileged STIR access, Thread-mode return rules, and on cached cores the instruction/data cache and branch predictor enables.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000200</resetValue>
          <fields>
            <field>
              <name>USERSETMPEND</name>
              <description>1 = unprivileged software may write STIR to set interrupts pending.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UNALIGN_TRP</name>
              <description>1 = unaligned halfword/word loads and stores raise an UNALIGNED UsageFault. Multi-word accesses (LDM/STM/LDRD/STRD) always fault when unaligned. Always 1 on ARMv6-M.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DIV_0_TRP</name>
              <description>1 = SDIV/UDIV by zero raises a DIVBYZERO UsageFault; 0 = the result is 0.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BFHFNMIGN</name>
              <description>Bus faults ignored at priority -1/-2: 1 = precise data BusFaults are ignored (the load returns 0, the store is dropped) in HardFault, NMI and FAULTMASK handlers. Used by probing code that must not lock up.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STKOFHFNMIGN</name>
              <description>Stack overflow ignored at priority -1/-2 (ARMv8-M): 1 = stack limit checks are disabled while executing at HardFault/NMI priority.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DC</name>
              <description>Data cache enable. Invalidate the cache before enabling (SCB_EnableDCache does this); clean before disabling.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IC</name>
              <description>Instruction cache enable. Invalidate before enabling (SCB_EnableICache).</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BP</name>
              <description>Branch prediction enable. Reads as 1 (RAO) on Cortex-M7; on ARMv8-M cores it is implementation defined whether it is writable.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHPR1</name>
          <description>System Handler Priority Register 1: priorities of MemManage, BusFault, UsageFault and SecureFault. Only the top nvicPrioBits of each byte are implemented.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_4</name>
              <description>Priority of system handler 4, MemManage.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_5</name>
              <description>Priority of system handler 5, BusFault.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_6</name>
              <description>Priority of system handler 6, UsageFault.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_7</name>
              <description>Priority of system handler 7, SecureFault (Security Extension only).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHPR2</name>
          <description>System Handler Priority Register 2: priority of SVCall. Only the top nvicPrioBits of each byte are implemented.</description>
          <addressOffset>0x01C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_11</name>
              <description>Priority of system handler 11, SVCall.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHPR3</name>
          <description>System Handler Priority Register 3: priorities of DebugMonitor, PendSV and SysTick. Only the top nvicPrioBits of each byte are implemented.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_12</name>
              <description>Priority of system handler 12, DebugMonitor.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_14</name>
              <description>Priority of system handler 14, PendSV.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_15</name>
              <description>Priority of system handler 15, SysTick.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHCSR</name>
          <description>System Handler Control and State Register: enable bits for the configurable fault exceptions and the active/pending state of every system handler. A configurable fault whose enable bit is 0 escalates to HardFault.</description>
          <addressOffset>0x024</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>HARDFAULTACT</name>
              <description>HardFault exception active (ARMv8-M).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NMIACT</name>
              <description>NMI exception active (ARMv8-M).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SVCALLACT</name>
              <description>SVCall exception active.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDSVACT</name>
              <description>PendSV exception active.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSTICKACT</name>
              <description>SysTick exception active.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SVCALLPENDED</name>
              <description>SVCall pending.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HARDFAULTPENDED</name>
              <description>HardFault pending (ARMv8-M).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MPU</name>
      <description>Memory Protection Unit (optional): programmable regions with access permissions and memory attributes, checked on every access. ARMv6-M/v7-M (PMSAv7) use RBAR/RASR power-of-two regions; ARMv8-M (PMSAv8) uses RBAR/RLAR base-limit regions with MAIR attributes.</description>
      <baseAddress>0xE000ED90</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x038</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TYPE</name>
          <description>MPU Type Register: how many regions the MPU implements (0 = no MPU). Read-only.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SEPARATE</name>
              <description>0 = unified MPU (instruction and data share the regions). Always 0 on Cortex-M.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DREGION</name>
              <description>Number of MPU regions implemented (0 = no MPU; Cortex-M cores offer 8 or 16).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IREGION</name>
              <description>Number of instruction regions; always 0 (unified).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>MPU Control Register: global enable, behaviour during HardFault/NMI, and the privileged default memory map.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>MPU enable. When 0 the default memory map applies to all accesses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HFNMIENA</name>
              <description>1 = the MPU stays enabled during HardFault, NMI and FAULTMASK handlers; 0 = those handlers use the default memory map (the usual choice).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRIVDEFENA</name>
              <description>1 = privileged accesses to addresses not covered by any enabled region use the default memory map; 0 = they raise a MemManage fault (unprivileged accesses always fault).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RNR</name>
          <description>MPU Region Number Register: selects the region that RBAR and RASR/RLAR access.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>REGION</name>
              <description>Region number selected for RBAR/RASR (RLAR) accesses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR</name>
          <description>MPU Region Base Address Register for the region selected by RNR (ARMv7-M: also selects the region when VALID is set). ARMv8-M: base address, shareability, access permissions and XN.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>XN</name>
              <description>Execute never: 1 = instruction fetches from this region fault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AP</name>
              <description>Access permissions: 0 = read/write privileged only, 1 = read/write any privilege, 2 = read-only privileged only, 3 = read-only any privilege.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RW_PRIV</name>
                  <description>Read/write, privileged only</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RW_ANY</name>
                  <description>Read/write, any privilege</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_PRIV</name>
                  <description>Read-only, privileged only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_ANY</name>
                  <description>Read-only, any privilege</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SH</name>
              <description>Shareability of Normal memory: 0 = non-shareable, 2 = outer shareable, 3 = inner shareable (1 reserved). Ignored for Device memory.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NonShareable</name>
                  <description>Non-shareable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OuterShareable</name>
                  <description>Outer shareable</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>InnerShareable</name>
                  <description>Inner shareable</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BASE</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR</name>
          <description>MPU Region Limit Address Register (ARMv8-M PMSAv8): inclusive end address, attribute index into MAIR0/1 and enable of the selected region.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AttrIndx</name>
              <description>Index (0-7) of the MAIR0/MAIR1 attribute byte that gives the memory type and cacheability of this region.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>LIMIT</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1, so the region is inclusive up to LIMIT + 31.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MAIR0</name>
          <description>MPU Memory Attribute Indirection Register 0: memory type/cacheability encodings 0-3 referenced by RLAR.AttrIndx.</description>
          <addressOffset>0x030</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>Attr0</name>
              <description>Memory attribute encoding 0, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr1</name>
              <description>Memory attribute encoding 1, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr2</name>
              <description>Memory attribute encoding 2, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr3</name>
              <description>Memory attribute encoding 3, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MAIR1</name>
          <description>MPU Memory Attribute Indirection Register 1: memory type/cacheability encodings 4-7 referenced by RLAR.AttrIndx.</description>
          <addressOffset>0x034</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>Attr4</name>
              <description>Memory attribute encoding 4, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr5</name>
              <description>Memory attribute encoding 5, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr6</name>
              <description>Memory attribute encoding 6, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr7</name>
              <description>Memory attribute encoding 7, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SAU</name>
      <description>Security Attribution Unit (ARMv8-M Security Extension): defines which address ranges are Non-secure or Secure Non-secure-callable; everything else is Secure. Also holds the SecureFault status and address registers.</description>
      <baseAddress>0xE000EDD0</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x014</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>SAU Control Register: enable, and what the memory map looks like while the SAU is disabled.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>SAU enable. When 0 the whole address space is Secure (ALLNS = 0) or Non-secure (ALLNS = 1), subject to the IDAU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALLNS</name>
              <description>All Non-secure: with the SAU disabled, 1 = memory not marked Secure by the IDAU is Non-secure, 0 = all memory is Secure.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TYPE</name>
          <description>SAU Type Register: number of SAU regions implemented (0, 4 or 8 on Arm cores). Read-only.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SREGION</name>
              <description>Number of SAU regions implemented (0, 4 or 8).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RNR</name>
          <description>SAU Region Number Register: selects the region that RBAR and RLAR access.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>REGION</name>
              <description>Region selected for RBAR/RLAR accesses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR</name>
          <description>SAU Region Base Address Register: start address (32-byte aligned) of the selected region.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>BADDR</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR</name>
          <description>SAU Region Limit Address Register: inclusive end address, Non-secure-callable attribute and enable of the selected region.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NSC</name>
              <description>1 = the region is Secure and Non-secure-callable (holds the SG entry veneers); 0 = the region is Non-secure.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LADDR</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1 (inclusive limit).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DCB</name>
      <description>Debug Control Block: halting debug control and status (DHCSR), core register access from the debugger (DCRSR/DCRDR), vector catch, the DebugMonitor exception and trace enable (DEMCR), and on ARMv8-M debug authentication and security control.</description>
      <baseAddress>0xE000EDF0</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x01C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DHCSR</name>
          <description>Debug Halting Control and Status Register: debugger enable, halt, step and interrupt masking (writes need 0xA05F in bits [31:16], DBGKEY), and read-only processor status (halted, sleeping, locked up, reset since last read) in the same upper bits.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>C_DEBUGEN</name>
              <description>Halting debug enable. Set by the debugger; cannot be set by software. While 0 the other C_* bits are ignored and BKPT with no monitor escalates to HardFault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_HALT</name>
              <description>Halt request: 1 = halt the processor (Debug state); 0 = run. Needs C_DEBUGEN = 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_STEP</name>
              <description>Single step: 1 = when leaving Debug state, execute one instruction and halt again.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_MASKINTS</name>
              <description>Mask PendSV, SysTick and IRQ (not NMI/faults) while stepping, so a step does not enter an interrupt handler. Change only while halted, together with C_HALT.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S_REGRDY</name>
              <description>Register transfer complete: a DCRSR read/write has finished and DCRDR is valid. Read-only.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_HALT</name>
              <description>Processor is in Debug state (halted). Read-only.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_SLEEP</name>
              <description>Processor is sleeping (WFI, WFE or sleep-on-exit). Read-only.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_LOCKUP</name>
              <description>Processor is in lockup state - a fault occurred at priority -1 or in NMI/HardFault with no way to escalate; PC reads 0xFFFFFFFE. Read-only.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_SDE</name>
              <description>Secure debug enabled: 1 = halting debug is permitted in Secure state (DAUTHSTATUS.SID). Read-only.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_RETIRE_ST</name>
              <description>Sticky: at least one instruction retired since the last read of DHCSR. Cleared on read.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_RESET_ST</name>
              <description>Sticky: the processor was reset since the last read of DHCSR. Cleared on read.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_RESTART_ST</name>
              <description>Sticky: the processor left Debug state (restarted) since the last read (ARMv8-M). Cleared on read.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DCRSR</name>
          <description>Debug Core Register Selector Register: with the processor halted, selects a core register to transfer to or from DCRDR. Poll DHCSR.S_REGRDY for completion.</description>
          <addressOffset>0x004</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>REGSEL</name>
              <description>Register to transfer: 0-12 R0-R12, 13 SP (current), 14 LR, 15 DebugReturnAddress (PC), 16 xPSR, 17 MSP, 18 PSP, 20 packed CONTROL[31:24] FAULTMASK[16] BASEPRI[8] PRIMASK[0], 33 FPSCR, 64-95 S0-S31; ARMv8-M: 24 MSP_NS, 25 PSP_NS, 26 MSP_S, 27 PSP_S, 28 MSPLIM_S, 29 PSPLIM_S, 30 MSPLIM_NS, 31 PSPLIM_NS, 34/35 packed CONTROL/masks _S/_NS.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>REGWnR</name>
              <description>Direction: 0 = read the selected register into DCRDR, 1 = write DCRDR to the selected register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCRDR</name>
          <description>Debug Core Register Data Register: data for DCRSR transfers. Also usable as a general debugger-to-target mailbox.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>DBGTMP</name>
              <description>Data read from, or to be written to, the register selected by DCRSR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEMCR</name>
          <description>Debug Exception and Monitor Control Register: vector catch on reset and faults, DebugMonitor exception control, and TRCENA, the global enable for DWT, ITM, ETM and TPIU.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VC_CORERESET</name>
              <description>Vector catch on core reset: halt immediately after reset (the 'reset catch' debuggers use to stop at the first instruction). Needs C_DEBUGEN.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_HARDERR</name>
              <description>Vector catch on HardFault entry - with this set the core halts at the fault instead of running the HardFault handler.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRCENA</name>
              <description>Trace enable: global enable for the DWT, ITM, ETM and TPIU. Must be 1 before any DWT/ITM register is written (CYCCNT, watchpoints, SWO output).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DAUTHCTRL</name>
          <description>Debug Authentication Control Register (ARMv8-M): lets Secure software override the external SPIDEN/SPNIDEN debug authentication inputs.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SPIDENSEL</name>
              <description>1 = INTSPIDEN overrides the external SPIDEN input (Secure invasive debug enable).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTSPIDEN</name>
              <description>Internal Secure invasive debug enable, used when SPIDENSEL = 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SPNIDENSEL</name>
              <description>1 = INTSPNIDEN overrides the external SPNIDEN input (Secure non-invasive debug/trace enable).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTSPNIDEN</name>
              <description>Internal Secure non-invasive debug enable, used when SPNIDENSEL = 1.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DSCSR</name>
          <description>Debug Security Control and Status Register (ARMv8-M): the current security state of the core and which banked register set the debugger sees.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SBRSELEN</name>
              <description>Secure banked register select enable: 1 = SBRSEL chooses which security state's banked registers DCRSR accesses; 0 = the current state's.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SBRSEL</name>
              <description>Security state of the banked registers accessed through DCRSR when SBRSELEN = 1: 0 = Non-secure, 1 = Secure.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CDS</name>
              <description>Current domain Secure: 1 = the processor is in Secure state. The debugger may write it (with CDSKEY = 0) while halted to switch state.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CDSKEY</name>
              <description>CDS write key: CDS is only updated if this bit is written as 0 in the same access. Reads as 1.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DIB</name>
      <description>Debug Identification Block (ARMv8-M): software lock, debug authentication status and the SCS CoreSight architecture and type IDs.</description>
      <baseAddress>0xE000EFB0</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x014</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DLAR</name>
          <description>SCS Software Lock Access Register: write 0xC5ACCE55 to unlock software writes to the SCS debug registers when the software lock is implemented (DLSR.SLI).</description>
          <addressOffset>0x000</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>Write 0xC5ACCE55 to unlock software access to the SCS debug registers; any other value locks them.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DLSR</name>
          <description>SCS Software Lock Status Register: whether a software lock exists and whether it is currently locked.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SLI</name>
              <description>Software lock implemented.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLK</name>
              <description>Software lock status: 1 = locked (software writes to the debug registers are ignored; the debugger is never locked).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>nTT</name>
              <description>Not thirty-two bit: 0 = DLAR is a 32-bit register.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DAUTHSTATUS</name>
          <description>Debug Authentication Status Register: which kinds of debug (invasive/non-invasive, Secure/Non-secure, unprivileged) are currently enabled.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NSID</name>
              <description>Non-secure invasive debug: 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSNID</name>
              <description>Non-secure non-invasive debug (trace): 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SID</name>
              <description>Secure invasive debug: 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SNID</name>
              <description>Secure non-invasive debug: 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DDEVARCH</name>
          <description>SCS Device Architecture Register: CoreSight ARCHID of the debug architecture (0x2A04 = ARMv8-M debug) and the architect (Arm, 0x23B).</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ARCHPART</name>
              <description>Architecture part: 0xA04 = M-profile system control space (with ARCHVER 2 -&gt; ARCHID 0x2A04, ARMv8-M debug).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>ARCHVER</name>
              <description>Architecture version: 2 = ARMv8-M debug architecture.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DDEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect: 0x23B = Arm.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DDEVTYPE</name>
          <description>SCS Device Type Register: CoreSight major/sub type of the SCS (0x00 = processor system control).</description>
          <addressOffset>0x010</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 = miscellaneous / processor system control.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type: 0 for the SCS.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="SysTick">
      <name>SysTick_NS</name>
      <description>Non-secure alias of SysTick at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002E010</baseAddress>
    </peripheral>
    <peripheral derivedFrom="NVIC">
      <name>NVIC_NS</name>
      <description>Non-secure alias of NVIC at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002E100</baseAddress>
    </peripheral>
    <peripheral derivedFrom="SCB">
      <name>SCB_NS</name>
      <description>Non-secure alias of SCB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002ED00</baseAddress>
    </peripheral>
    <peripheral derivedFrom="MPU">
      <name>MPU_NS</name>
      <description>Non-secure alias of MPU at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002ED90</baseAddress>
    </peripheral>
    <peripheral derivedFrom="DCB">
      <name>DCB_NS</name>
      <description>Non-secure alias of DCB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002EDF0</baseAddress>
    </peripheral>
    <peripheral derivedFrom="DIB">
      <name>DIB_NS</name>
      <description>Non-secure alias of DIB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002EFB0</baseAddress>
    </peripheral>
    <peripheral>
      <name>TPIU</name>
      <description>Trace Port Interface Unit: drives the ITM/DWT/ETM trace out through the parallel trace port or the single-wire SWO pin (Manchester or UART/NRZ). ACPR sets the SWO baud rate, SPPR the pin protocol, FFCR the formatter.</description>
      <baseAddress>0xE0040000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x014</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x0F0</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x300</offset>
        <size>0x00C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xEE8</offset>
        <size>0x01C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFA0</offset>
        <size>0x060</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SSPSR</name>
          <description>Supported Parallel Port Size Register: bit n-1 set = a trace port width of n bits is supported. Read-only.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SWIDTH</name>
              <description>Bit n-1 set = a trace port width of n bits is supported.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CSPSR</name>
          <description>Current Parallel Port Size Register: one-hot, bit n-1 = width n; must be 1 (bit 0) for SWO.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CWIDTH</name>
              <description>One-hot current port width: bit n-1 = n bits. 1 = single-bit (SWO).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ACPR</name>
          <description>Asynchronous Clock Prescaler Register: SWO baud rate = TRACECLKIN / (PRESCALER + 1).</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRESCALER</name>
              <description>SWO clock divider: baud rate = TRACECLKIN / (PRESCALER + 1). For example 4 MHz SWO from 200 MHz: PRESCALER = 49.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SPPR</name>
          <description>Selected Pin Protocol Register: parallel trace port, SWO Manchester or SWO NRZ (UART).</description>
          <addressOffset>0x0F0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TXMODE</name>
              <description>Pin protocol: 0 = parallel trace port, 1 = SWO Manchester, 2 = SWO NRZ (UART-like, the common choice), 3 = reserved.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Parallel</name>
                  <description>Parallel trace port</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWO_Manchester</name>
                  <description>Serial wire output, Manchester encoding</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWO_NRZ</name>
                  <description>Serial wire output, NRZ (UART) encoding</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FFSR</name>
          <description>Formatter and Flush Status Register.</description>
          <addressOffset>0x300</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>FlInProg</name>
              <description>Flush in progress.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FtStopped</name>
              <description>Formatter stopped (RAZ on cores whose formatter cannot stop).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TCPresent</name>
              <description>TRACECTL pin present: 1 = the trace port has a TRACECTL signal.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FtNonStop</name>
              <description>Formatter cannot be stopped (reads 1).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FFCR</name>
          <description>Formatter and Flush Control Register: enable continuous formatting (needed when the ETM and ITM share the port), manual flush, trigger indication.</description>
          <addressOffset>0x304</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EnFCont</name>
              <description>Enable continuous formatting: 1 = frames are always formatted with source IDs (required when the ETM and ITM share the trace port; must be 0 for ITM-only SWO to get raw ITM packets).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FOnMan</name>
              <description>Manual flush: write 1 to flush the formatter FIFO now.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TrigIn</name>
              <description>Indicate a trigger on the TRIGIN input in the formatted stream (reads 1).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PSCR</name>
          <description>Periodic Synchronization Control Register: how often the formatter inserts synchronization packets.</description>
          <addressOffset>0x308</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PSCount</name>
              <description>Periodic synchronization: 0 = disabled; else a synchronization sequence is inserted every 2^PSCount bytes (minimum 7 = 128 bytes).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TRIGGER</name>
          <description>Integration register: the current state of the TRIGIN input.</description>
          <addressOffset>0xEE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TRIGGER</name>
              <description>Current state of the TRIGIN input.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITFTTD0</name>
          <description>Integration Test FIFO Test Data 0: ATB interface 1 (ETM) data bytes and handshake flags (integration mode).</description>
          <addressOffset>0xEEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATB_IF1_data0</name>
              <description>ATB interface 1 data byte 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_data1</name>
              <description>ATB interface 1 data byte 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_data2</name>
              <description>ATB interface 1 data byte 2.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_bytecount</name>
              <description>ATB interface 1 valid bytes - 1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_ATVALID</name>
              <description>ATB interface 1 ATVALID.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_bytecount</name>
              <description>ATB interface 2 valid bytes - 1.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_ATVALID</name>
              <description>ATB interface 2 ATVALID.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR2</name>
          <description>Integration Test ATB Control 2: ATREADY/AFVALID outputs to the ATB masters (integration mode).</description>
          <addressOffset>0xEF0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ATREADY1S</name>
              <description>ATB interface 1 ATREADY (integration).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AFVALID1S</name>
              <description>ATB interface 1 AFVALID (integration).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR0</name>
          <description>Integration Test ATB Control 0: ATVALID/AFREADY inputs from the ATB masters (integration mode).</description>
          <addressOffset>0xEF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATREADY1S</name>
              <description>ATB interface 1 ATREADY (integration).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AFVALID1S</name>
              <description>ATB interface 1 AFVALID (integration).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITFTTD1</name>
          <description>Integration Test FIFO Test Data 1: ATB interface 2 (ITM) data bytes and handshake flags (integration mode).</description>
          <addressOffset>0xEFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATB_IF2_data0</name>
              <description>ATB interface 2 data byte 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_data1</name>
              <description>ATB interface 2 data byte 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_data2</name>
              <description>ATB interface 2 data byte 2.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_bytecount</name>
              <description>ATB interface 1 valid bytes - 1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_ATVALID</name>
              <description>ATB interface 1 ATVALID.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_bytecount</name>
              <description>ATB interface 2 valid bytes - 1.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_ATVALID</name>
              <description>ATB interface 2 ATVALID.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITCTRL</name>
          <description>Integration Mode Control Register.</description>
          <addressOffset>0xF00</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>Mode</name>
              <description>Integration mode: 0 = normal operation, 1 = integration test mode (the IT* registers drive/observe the ATB and trace port).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMSET</name>
          <description>Claim Tag Set Register: read = which claim bits are implemented, write 1 = set a claim bit. Lets a debugger and software signal ownership of the TPIU.</description>
          <addressOffset>0xFA0</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>CLAIMCLR</name>
          <description>Claim Tag Clear Register: read = current claim tag, write 1 = clear a bit.</description>
          <addressOffset>0xFA4</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>DEVID</name>
          <description>Device Configuration Register: number of trace inputs, FIFO size and which pin protocols are supported. Read-only.</description>
          <addressOffset>0xFC8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NrTraceInput</name>
              <description>Number of ATB trace inputs (implementation-defined encoding, see the core TRM; Cortex-M cores with an ETM have two: ETM and ITM).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>FIFOSZ</name>
              <description>Formatter FIFO size, log2 of the number of words (2 = 4 words on Cortex-M33/M55).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PTINVALID</name>
              <description>1 = the parallel trace port is NOT supported (SWO only).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MANCVALID</name>
              <description>1 = SWO Manchester encoding is supported.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NRZVALID</name>
              <description>1 = SWO NRZ (UART) encoding is supported.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: 0x11 (trace sink, trace port). Read-only.</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MajorType</name>
              <description>Major type: 1 = trace sink.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SubType</name>
              <description>Sub type: 1 = trace port (TPIU).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CTI</name>
      <description>Cross Trigger Interface (CoreSight CTI, optional): routes debug events (halt, restart, DWT/ETM triggers) between the core and the rest of the SoC over four cross-trigger channels. Cortex-M33/M55/M85 implement 8 triggers in and out.</description>
      <baseAddress>0xE0042000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x040</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x0A0</offset>
        <size>0x020</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x130</offset>
        <size>0x018</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xEE4</offset>
        <size>0x020</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFA0</offset>
        <size>0x060</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTICONTROL</name>
          <description>CTI Control Register.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>GLBEN</name>
              <description>Global enable: 1 = the CTI passes trigger events to and from the channels.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIINTACK</name>
          <description>CTI Interrupt Acknowledge Register: write 1 to clear an active trigger output (needed for level-sensitive outputs such as the debug request).</description>
          <addressOffset>0x010</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>INTACK</name>
              <description>Bit n acknowledges trigger output n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIAPPSET</name>
          <description>CTI Application Trigger Set Register: software-generated channel events.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>APPSET</name>
              <description>Write 1 to bit n to raise an event on channel n; reads the current application trigger state.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIAPPCLEAR</name>
          <description>CTI Application Trigger Clear Register.</description>
          <addressOffset>0x018</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>APPCLEAR</name>
              <description>Write 1 to bit n to clear the application trigger on channel n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIAPPPULSE</name>
          <description>CTI Application Pulse Register: one-cycle channel event.</description>
          <addressOffset>0x01C</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>APPULSE</name>
              <description>Write 1 to bit n to pulse channel n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>CTIINEN%s</name>
          <description>CTI Trigger to Channel Enable Register n: which channels trigger input n drives. Cortex-M trigger inputs: 0 core halted, 1 DWT comparator 0, 2 DWT comparator 1, 3 DWT comparator 2, 4 ETM event 0, 5 ETM event 1, 6-7 implementation defined.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TRIGINEN</name>
              <description>Bit k: trigger input n generates an event on channel k.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>CTIOUTEN%s</name>
          <description>CTI Channel to Trigger Enable Register n: which channels drive trigger output n. Cortex-M trigger outputs: 0 debug request (halt), 1 restart, 2-3 CTI interrupts, 4-7 ETM external inputs / implementation defined.</description>
          <addressOffset>0x0A0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TRIGOUTEN</name>
              <description>Bit k: an event on channel k asserts trigger output n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTITRIGINSTATUS</name>
          <description>CTI Trigger In Status Register.</description>
          <addressOffset>0x130</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TRIGINSTATUS</name>
              <description>Bit n: trigger input n is asserted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTITRIGOUTSTATUS</name>
          <description>CTI Trigger Out Status Register.</description>
          <addressOffset>0x134</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TRIGOUTSTATUS</name>
              <description>Bit n: trigger output n is asserted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTICHINSTATUS</name>
          <description>CTI Channel In Status Register.</description>
          <addressOffset>0x138</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CTICHINSTATUS</name>
              <description>Bit k: channel k input is active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTICHOUTSTATUS</name>
          <description>CTI Channel Out Status Register.</description>
          <addressOffset>0x13C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CTICHOUTSTATUS</name>
              <description>Bit k: channel k output is active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIGATE</name>
          <description>CTI Channel Gate Enable Register: which channels propagate to the external cross-trigger matrix. Reset value 0xF (all open).</description>
          <addressOffset>0x140</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CTIGATEEN</name>
              <description>Bit k: 1 = channel k events pass to/from the CTM, 0 = channel k is internal to this CTI.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ASICCTL</name>
          <description>External Multiplexer Control Register (implementation defined; reserved on Cortex-M).</description>
          <addressOffset>0x144</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>ITCHOUT</name>
          <description>Integration Test Channel Output Register (integration mode only).</description>
          <addressOffset>0xEE4</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>ITTRIGOUT</name>
          <description>Integration Test Trigger Output Register (integration mode only).</description>
          <addressOffset>0xEE8</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>ITCHIN</name>
          <description>Integration Test Channel Input Register (integration mode only).</description>
          <addressOffset>0xEF4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ITTRIGIN</name>
          <description>Integration Test Trigger Input Register (integration mode only).</description>
          <addressOffset>0xEF8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ITCTRL</name>
          <description>Integration Mode Control Register.</description>
          <addressOffset>0xF00</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IME</name>
              <description>Integration mode enable: 1 = the IT* registers drive and observe the CTI ports.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMSET</name>
          <description>Claim Tag Set Register: reads the implemented claim bits (1 = implemented), write 1 to set a claim bit. Used by debuggers and software to negotiate ownership.</description>
          <addressOffset>0xFA0</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>CLAIMCLR</name>
          <description>Claim Tag Clear Register: reads the current claim tag, write 1 to clear a claim bit.</description>
          <addressOffset>0xFA4</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>DEVAFF0</name>
          <description>Device Affinity Register 0 (implementation defined).</description>
          <addressOffset>0xFA8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>DEVAFF1</name>
          <description>Device Affinity Register 1 (implementation defined).</description>
          <addressOffset>0xFAC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>LAR</name>
          <description>Lock Access Register: write 0xC5ACCE55 to unlock the component for software (not debugger) writes.</description>
          <addressOffset>0xFB0</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>Write 0xC5ACCE55 to unlock, any other value to lock.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LSR</name>
          <description>Lock Status Register.</description>
          <addressOffset>0xFB4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SLI</name>
              <description>Software lock implemented.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLK</name>
              <description>Software lock status: 1 = locked, writes from software are ignored.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>nTT</name>
              <description>Not thirty-two bit: 0 = the lock register is 32-bit.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AUTHSTATUS</name>
          <description>Authentication Status Register: which debug and trace features the DAUTH/SPIDEN inputs currently permit.</description>
          <addressOffset>0xFB8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NSID</name>
              <description>Non-secure invasive debug: 0b10 disabled, 0b11 enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSNID</name>
              <description>Non-secure non-invasive debug.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SID</name>
              <description>Secure invasive debug.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SNID</name>
              <description>Secure non-invasive debug.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVARCH</name>
          <description>Device Architecture Register: the architecture of the component (CoreSight ARCHID) and its architect.</description>
          <addressOffset>0xFBC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ARCHID</name>
              <description>Architecture ID, including the architecture part number [11:0] and revision [15:12].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect (Arm: 0x23B).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVID2</name>
          <description>Device Configuration Register 2 (reserved).</description>
          <addressOffset>0xFC0</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>DEVID1</name>
          <description>Device Configuration Register 1 (reserved).</description>
          <addressOffset>0xFC4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>DEVID</name>
          <description>Device Configuration Register: CTI topology.</description>
          <addressOffset>0xFC8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>EXTMUXNUM</name>
              <description>Number of multiplexers on the trigger inputs and outputs (0 on Cortex-M).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>NUMTRIG</name>
              <description>Number of triggers implemented.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>NUMCH</name>
              <description>Number of channels implemented.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>INOUT</name>
              <description>Input/output options: 0 = no CTIGATE mask on CTM.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: major and sub type of the CoreSight component.</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 miscellaneous, 1 trace sink, 2 trace link, 3 trace source, 4 debug control, 5 debug logic, 6 PMU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type within the major class.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>

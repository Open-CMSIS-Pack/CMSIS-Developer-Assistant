    <peripheral>
      <name>PMU</name>
      <description>Performance Monitoring Unit (ARMv8.1-M): a 32-bit cycle counter and up to 8 (architecturally 31) 16-bit event counters selecting from the PMU event list (instructions, cache refills, branch mispredictions, MVE activity ...), with overflow interrupt/halt.</description>
      <baseAddress>0xE0003000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x020</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x07C</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x400</offset>
        <size>0x020</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x47C</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xC00</offset>
        <size>0x0C4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xE00</offset>
        <size>0x008</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFB8</offset>
        <size>0x048</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>EVCNTR%s</name>
          <description>Event Counter n: 16-bit count of the event selected in EVTYPERn. Only NUM_CNTS counters exist (8 on Cortex-M55/M85); the rest read as zero.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CNT</name>

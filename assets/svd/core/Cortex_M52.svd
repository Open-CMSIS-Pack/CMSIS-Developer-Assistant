              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT17_STATUS</name>
              <description>Event counter 17 overflow flag; write 1 to set it.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT18_STATUS</name>
              <description>Event counter 18 overflow flag; write 1 to set it.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT19_STATUS</name>
              <description>Event counter 19 overflow flag; write 1 to set it.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT20_STATUS</name>
              <description>Event counter 20 overflow flag; write 1 to set it.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT21_STATUS</name>
              <description>Event counter 21 overflow flag; write 1 to set it.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT22_STATUS</name>
              <description>Event counter 22 overflow flag; write 1 to set it.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT23_STATUS</name>
              <description>Event counter 23 overflow flag; write 1 to set it.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT24_STATUS</name>
              <description>Event counter 24 overflow flag; write 1 to set it.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT25_STATUS</name>
              <description>Event counter 25 overflow flag; write 1 to set it.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT26_STATUS</name>
              <description>Event counter 26 overflow flag; write 1 to set it.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT27_STATUS</name>
              <description>Event counter 27 overflow flag; write 1 to set it.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT28_STATUS</name>
              <description>Event counter 28 overflow flag; write 1 to set it.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT29_STATUS</name>
              <description>Event counter 29 overflow flag; write 1 to set it.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT30_STATUS</name>
              <description>Event counter 30 overflow flag; write 1 to set it.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CYCCNT_STATUS</name>
              <description>Cycle counter overflow flag; write 1 to set it.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TYPE</name>
          <description>PMU Type Register: how many counters exist, their size, and which options are supported. Read-only.</description>
          <addressOffset>0xE00</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>NUM_CNTS</name>
              <description>Number of event counters implemented (8 on Cortex-M55/M85/M52).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>SIZE_CNTS</name>
              <description>Event counter size - 1 in bits (15 = 16-bit counters).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CYCCNT_PRESENT</name>
              <description>1 = the cycle counter CCNTR is implemented.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FRZ_OV_SUPPORT</name>
              <description>1 = freeze-on-overflow (CTRL.FRZ_ON_OV) is supported.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRACE_ON_OV_SUPPORT</name>
              <description>1 = trace-on-overflow (CTRL.TRACE_ON_OV) is supported.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>PMU Control Register: global enable, counter resets, cycle counter disable, freeze/trace on overflow.</description>
          <addressOffset>0xE04</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Global enable: 0 = all counters stop (their values are kept).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EVENTCNT_RESET</name>
              <description>Write 1 to reset every event counter to 0. Reads as 0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CYCCNT_RESET</name>
              <description>Write 1 to reset CCNTR to 0. Reads as 0.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CYCCNT_DISABLE</name>
              <description>1 = the cycle counter is disabled even when ENABLE = 1.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FRZ_ON_OV</name>
              <description>Freeze on overflow: 1 = all counters stop when any counter overflows, so a snapshot can be read.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRACE_ON_OV</name>
              <description>Trace on overflow: 1 = a counter overflow emits a trace (ITM/ETM) event.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AUTHSTATUS</name>
          <description>Authentication Status Register: which debug/trace permissions currently apply to the PMU.</description>
          <addressOffset>0xFB8</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>NSID</name>
              <description>Non-secure invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSNID</name>
              <description>Non-secure non-invasive debug: 2 = disabled, 3 = enabled. Counting Non-secure events requires it.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SID</name>
              <description>Secure invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SNID</name>
              <description>Secure non-invasive debug: 2 = disabled, 3 = enabled. Counting Secure events requires it.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSUID</name>
              <description>Non-secure unprivileged invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSUNID</name>
              <description>Non-secure unprivileged non-invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SUID</name>
              <description>Secure unprivileged invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SUNID</name>
              <description>Secure unprivileged non-invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVARCH</name>
          <description>Device Architecture Register: CoreSight ARCHID of the PMU (0x0A06 with revision -&gt; 0x2A06).</description>
          <addressOffset>0xFBC</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARCHID</name>
              <description>Architecture ID, including the architecture part number [11:0] and revision [15:12].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect (Arm: 0x23B).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: 0x16 (performance monitor, processor core).</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 miscellaneous, 1 trace sink, 2 trace link, 3 trace source, 4 debug control, 5 debug logic, 6 PMU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type within the major class.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>ICB</name>
      <description>Implementation Control Block (ARMv8.1-M): interrupt controller type, the implementation-defined Auxiliary Control Register and coprocessor power control.</description>
      <baseAddress>0xE000E000</baseAddress>
      <addressBlock>
        <offset>0x004</offset>
        <size>0x00C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>ICTR</name>
          <description>Interrupt Controller Type Register: how many interrupt lines the NVIC supports, in groups of 32. Read-only.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>INTLINESNUM</name>
              <description>Number of interrupt lines in groups of 32: the NVIC supports up to 32 x (INTLINESNUM+1) interrupts.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ACTLR</name>
          <description>Auxiliary Control Register: implementation-defined controls that disable individual micro-architectural features of the core. Usually left at reset.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>DISFOLD</name>
              <description>1 = disable instruction folding.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISLOLEP</name>
              <description>1 = disable low-overhead-loop end prediction (the LE branch is predicted only from the LO loop cache).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISLO</name>
              <description>1 = disable the low-overhead-loop (LO) cache; loops fall back to ordinary branch handling.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISLOBR</name>
              <description>1 = disable low-overhead-loop branch prediction.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISOLAPS</name>
              <description>Disable overlapping of scalar instructions with MVE (vector) instructions in the pipeline (Secure-controlled variant).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISOLAP</name>
              <description>1 = disable overlapping (beat-wise interleaving) of MVE vector instructions with following instructions.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FPEXCODIS</name>
              <description>1 = disable the FPU exception outputs; the cumulative FPSCR flags still update.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISNWAMODE</name>
              <description>1 = disable no-write-allocate mode of the data cache (write misses then allocate).</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISITMATBFLUSH</name>
              <description>1 = disable the ITM and DWT ATB flush handshake.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EVENTBUSEN_S</name>
              <description>1 = enable the Secure event bus (PMU/DWT event export for Secure events).</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EVENTBUSEN</name>
              <description>1 = enable the event bus (exports PMU events on the EVENT interface).</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISCRITAXIRUR</name>
              <description>1 = disable critical-word-first AXI read-under-read.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DISDI</name>
              <description>Disable dual issue for the instruction classes selected by these bits (see the core TRM).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DISCRITAXIRUW</name>
              <description>1 = disable critical-word-first AXI read-under-write.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CPPWR</name>
          <description>Coprocessor Power Control Register (ARMv8.1-M): per-coprocessor 'state unknown' permissions that let the implementation power-gate the FPU/MVE and custom coprocessors.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SU10</name>
              <description>State Unknown for CP10 (FPU/MVE): 1 = the implementation may power down the unit and its register state may become unknown; software must then re-initialise it.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SUS10</name>
              <description>SU10 Secure only: 1 = SU10 can only be changed from Secure state.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SU11</name>
              <description>State Unknown for CP11 (FPU/MVE), must equal SU10.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SUS11</name>
              <description>SU11 Secure only.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SysTick</name>
      <description>24-bit system timer that counts down from LOAD to 0 on the processor or reference clock and can raise the SysTick exception; the usual RTOS tick source. Banked per security state on ARMv8-M with the Security Extension.</description>
      <baseAddress>0xE000E010</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x010</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>SysTick Control and Status Register: enable, interrupt enable, clock source and the sticky count-to-zero flag.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Counter enable: 1 = SysTick counts down from LOAD to 0 and reloads.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TICKINT</name>
              <description>1 = counting down to 0 sets the SysTick exception pending; 0 = poll COUNTFLAG instead.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLKSOURCE</name>
              <description>Clock source: 0 = external reference clock (implementation defined, e.g. HCLK/8), 1 = processor clock.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>External</name>
                  <description>External reference clock (implementation defined)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Processor</name>
                  <description>Processor clock</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>COUNTFLAG</name>
              <description>Reads 1 if the counter reached 0 since the last read of this register. Cleared by reading CTRL or writing VAL.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LOAD</name>
          <description>SysTick Reload Value Register: value loaded into VAL when the counter reaches 0. A period of N clocks needs RELOAD = N-1.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>RELOAD</name>
              <description>Value loaded into VAL when the counter reaches 0. A period of N clocks needs RELOAD = N-1; 0 is legal but the counter then never fires.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>VAL</name>
          <description>SysTick Current Value Register: the current count. Any write clears it to 0 and clears CTRL.COUNTFLAG; the next reload comes from LOAD.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CURRENT</name>
              <description>Current counter value. Any write clears the field to 0 and clears CTRL.COUNTFLAG.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CALIB</name>
          <description>SysTick Calibration Register: implementation-defined reload value for a 10 ms tick and whether a reference clock exists.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TENMS</name>
              <description>Reload value for a 10 ms period with the reference clock, or 0 if unknown. Implementation defined.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>SKEW</name>
              <description>1 = TENMS is not exact (a 10 ms tick cannot be produced exactly).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NOREF</name>
              <description>1 = no separate reference clock: CLKSOURCE reads 1 and cannot be cleared.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>NVIC</name>
      <description>Nested Vectored Interrupt Controller: enable, pending, active and priority registers for the external interrupts (IRQ0 = exception 16) and the software trigger register. Bit k of register n refers to IRQ 32n+k.</description>
      <baseAddress>0xE000E100</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x4F0</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xE00</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ISER%s</name>
          <description>Interrupt Set-Enable Register n (IRQ 32n..32n+31): write 1 to enable an interrupt, 0 has no effect; reads the enable state.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SETENA</name>
              <description>Bit k: write 1 to enable IRQ 32n+k; reads 1 if enabled. Writing 0 has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ICER%s</name>
          <description>Interrupt Clear-Enable Register n (IRQ 32n..32n+31): write 1 to disable an interrupt, 0 has no effect; reads the enable state.</description>
          <addressOffset>0x080</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLRENA</name>
              <description>Bit k: write 1 to disable IRQ 32n+k; reads 1 if enabled. Writing 0 has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ISPR%s</name>
          <description>Interrupt Set-Pending Register n (IRQ 32n..32n+31): write 1 to set an interrupt pending; reads the pending state.</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SETPEND</name>
              <description>Bit k: write 1 to set IRQ 32n+k pending; reads 1 if pending.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ICPR%s</name>
          <description>Interrupt Clear-Pending Register n (IRQ 32n..32n+31): write 1 to clear a pending interrupt; reads the pending state.</description>
          <addressOffset>0x180</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLRPEND</name>
              <description>Bit k: write 1 to clear IRQ 32n+k pending; reads 1 if pending.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>IABR%s</name>
          <description>Interrupt Active Bit Register n (IRQ 32n..32n+31): 1 = the interrupt handler is active (executing or preempted). Read-only.</description>
          <addressOffset>0x200</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ACTIVE</name>
              <description>Bit k: 1 = the handler of IRQ 32n+k is active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ITNS%s</name>
          <description>Interrupt Target Non-secure Register n (Security Extension): 1 = IRQ 32n+k targets Non-secure state. Secure access only; RAZ/WI from Non-secure.</description>
          <addressOffset>0x280</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ITNS</name>
              <description>Bit k: 1 = IRQ 32n+k targets Non-secure state, 0 = Secure.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>124</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>IPR%s</name>
          <description>Interrupt Priority Register n: one byte per interrupt, IRQ 4n+0 in bits [7:0] up to IRQ 4n+3 in [31:24]. Lower value = higher priority; only the top nvicPrioBits of each byte are implemented (ARMv6-M: 2, typical ARMv7-M: 3-4).</description>
          <addressOffset>0x300</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_N0</name>
              <description>Priority of interrupt 4n+0. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_N1</name>
              <description>Priority of interrupt 4n+1. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_N2</name>
              <description>Priority of interrupt 4n+2. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_N3</name>
              <description>Priority of interrupt 4n+3. Only the top nvicPrioBits (implementation defined, 2 to 8) are implemented; the rest read as zero.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STIR</name>
          <description>Software Trigger Interrupt Register: writing an interrupt number sets that interrupt pending (like ISPR). Unprivileged writes need CCR.USERSETMPEND.</description>
          <addressOffset>0xE00</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>INTID</name>
              <description>Interrupt number to set pending (0 = IRQ0, i.e. exception 16). Unprivileged writes are allowed when CCR.USERSETMPEND is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCB</name>
      <description>System Control Block: CPUID, exception control and state (ICSR, AIRCR, SHCSR), system configuration (SCR, CCR), system handler priorities, the fault status and address registers (CFSR, HFSR, DFSR, MMFAR, BFAR), CPU feature IDs, coprocessor access control, and on cores with caches the cache ID and maintenance registers.</description>
      <baseAddress>0xE000ED00</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x090</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x0E4</offset>
        <size>0x008</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x204</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x250</offset>
        <size>0x02C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CPUID</name>
          <description>CPUID Base Register: implementer, part number, architecture and revision of the processor (read-only).</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>REVISION</name>
              <description>Minor revision pM of the rNpM product revision.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PARTNO</name>
              <description>Part number: 0xC20 Cortex-M0, 0xC60 Cortex-M0+, 0xC21 Cortex-M1, 0xC23 Cortex-M3, 0xC24 Cortex-M4, 0xC27 Cortex-M7, 0xD20 Cortex-M23, 0xD21 Cortex-M33, 0xD31 Cortex-M35P, 0xD22 Cortex-M55, 0xD23 Cortex-M85, 0xD24 Cortex-M52.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>ARCHITECTURE</name>
              <description>Architecture: 0xC = ARMv6-M, 0xF = ARMv7-M or ARMv8-M (use ID_PFR/ID_ISAR for the details).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>VARIANT</name>
              <description>Major revision rN of the rNpM product revision.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>IMPLEMENTER</name>
              <description>Implementer code: 0x41 = Arm.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ICSR</name>
          <description>Interrupt Control and State Register: active and pending exception numbers, and set/clear-pending controls for NMI, PendSV and SysTick.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VECTACTIVE</name>
              <description>Exception number of the currently executing handler; 0 in Thread mode. 2 NMI, 3 HardFault, 4 MemManage, 5 BusFault, 6 UsageFault, 7 SecureFault, 11 SVCall, 12 DebugMonitor, 14 PendSV, 15 SysTick, 16+n IRQn.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RETTOBASE</name>
              <description>1 = the current handler is the only active exception (an exception return would go to Thread mode); 0 = another exception is preempted.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>VECTPENDING</name>
              <description>Exception number of the highest-priority pending enabled exception, 0 if none. Not affected by PRIMASK/FAULTMASK/BASEPRI.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ISRPENDING</name>
              <description>1 = an external interrupt (IRQ, not NMI or a fault) is pending.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ISRPREEMPT</name>
              <description>1 = a pending exception will be serviced when the processor leaves Debug state (debug use only).</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>STTNS</name>
              <description>SysTick Targets Non-secure (Security Extension, single-SysTick implementations): 1 = the SysTick exception targets Non-secure state. Secure write only.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDSTCLR</name>
              <description>Write 1 to clear a pending SysTick exception. Reads as 0.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PENDSTSET</name>
              <description>Write 1 to set the SysTick exception pending; reads 1 while it is pending.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDSVCLR</name>
              <description>Write 1 to clear a pending PendSV. Reads as 0.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PENDSVSET</name>
              <description>Write 1 to set PendSV pending (the usual RTOS context-switch trigger); reads 1 while it is pending.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDNMICLR</name>
              <description>Write 1 to clear a pending NMI (ARMv8-M; Secure or debugger access only). Reads as 0.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PENDNMISET</name>
              <description>Write 1 to set NMI pending; NMI is taken at once unless another NMI is active or the processor is halted. Reads 1 while pending. Secure or debugger access only when BFHFNMINS = 0.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>VTOR</name>
          <description>Vector Table Offset Register: base address of the exception vector table. Must be aligned to the table size rounded up to a power of two (at least 128 bytes). Reset value is implementation defined (usually 0; set by SystemInit when the table is relocated).</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TBLOFF</name>
              <description>Vector table base address. The table must be aligned to its size rounded up to a power of two (at least 128 bytes; the low bits read as zero).</description>
              <bitOffset>7</bitOffset>
              <bitWidth>25</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AIRCR</name>
          <description>Application Interrupt and Reset Control Register: priority grouping, endianness, system reset request and (ARMv8-M) security attribution of BusFault/HardFault/NMI. Writes must place 0x05FA in VECTKEY or are ignored.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <resetValue>0xFA050000</resetValue>
          <fields>
            <field>
              <name>VECTCLRACTIVE</name>
              <description>Debug use only: write 1 (with VECTKEY) to clear all active-exception state. Only while halted; otherwise unpredictable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSRESETREQ</name>
              <description>Write 1 (with VECTKEY = 0x05FA) to request a system reset (asserts SYSRESETREQ to the reset controller). Self-clearing; NVIC_SystemReset() uses this.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSRESETREQS</name>
              <description>System reset request Secure only (Security Extension): 1 = only Secure software or the debugger can set SYSRESETREQ.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DIT</name>
              <description>Data Independent Timing (ARMv8.1-M): 1 = the execution time of data-processing instructions does not depend on the data values.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IESB</name>
              <description>Implicit Error Synchronization Barrier (ARMv8.1-M RAS): 1 = an error synchronization barrier is inserted on every exception entry and return.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRIGROUP</name>
              <description>Priority grouping: bits [7:PRIGROUP+1] of each 8-bit priority are the group (preemption) priority, bits [PRIGROUP:0] the subpriority. 0 = 7 group bits (default), 7 = no preemption between interrupts (all subpriority).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>G7S1</name>
                  <description>7 group priority bits [7:1], 1 subpriority bits [0:0]</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G6S2</name>
                  <description>6 group priority bits [7:2], 2 subpriority bits [1:0]</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G5S3</name>
                  <description>5 group priority bits [7:3], 3 subpriority bits [2:0]</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G4S4</name>
                  <description>4 group priority bits [7:4], 4 subpriority bits [3:0]</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G3S5</name>
                  <description>3 group priority bits [7:5], 5 subpriority bits [4:0]</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G2S6</name>
                  <description>2 group priority bits [7:6], 6 subpriority bits [5:0]</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G1S7</name>
                  <description>1 group priority bits [7:7], 7 subpriority bits [6:0]</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>G0S8</name>
                  <description>0 group priority bits [7:8], 8 subpriority bits [7:0]</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BFHFNMINS</name>
              <description>BusFault, HardFault and NMI Non-secure (Security Extension): 1 = these exceptions target Non-secure state and Secure faults escalate to the Non-secure HardFault. 0 = they target Secure state.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRIS</name>
              <description>Prioritize Secure exceptions (Security Extension): 1 = Non-secure exception priorities are mapped to the lower half of the range, so any Secure exception can preempt them.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENDIANNESS</name>
              <description>Data endianness: 0 = little-endian, 1 = big-endian (BE8). Read-only, sampled at reset.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Little</name>
                  <description>Little-endian data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Big</name>
                  <description>Big-endian (BE8) data</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VECTKEY</name>
              <description>Register key: writes must contain 0x05FA here or the whole write is ignored. Reads as 0xFA05 (VECTKEYSTAT).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SCR</name>
          <description>System Control Register: sleep-on-exit, deep sleep selection and send-event-on-pending.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SLEEPONEXIT</name>
              <description>1 = the processor sleeps (as after WFI) whenever it returns from an exception handler to Thread mode. Interrupt-driven designs run entirely from handlers this way.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPDEEP</name>
              <description>1 = WFI, WFE and sleep-on-exit request deep sleep (SLEEPDEEP output; the implementation-defined low-power mode, often stopping clocks/PLL) instead of sleep.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPDEEPS</name>
              <description>Sleep Deep Secure only (Security Extension): 1 = SLEEPDEEP can only be written from Secure state.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SEVONPEND</name>
              <description>Send Event on Pending: 1 = an interrupt becoming pending (even a disabled one) wakes the processor from WFE, enabling the WFE-polling idle pattern.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CCR</name>
          <description>Configuration and Control Register: trapping of divide-by-zero and unaligned accesses, stack alignment, unprivileged STIR access, Thread-mode return rules, and on cached cores the instruction/data cache and branch predictor enables.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000200</resetValue>
          <fields>
            <field>
              <name>USERSETMPEND</name>
              <description>1 = unprivileged software may write STIR to set interrupts pending.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UNALIGN_TRP</name>
              <description>1 = unaligned halfword/word loads and stores raise an UNALIGNED UsageFault. Multi-word accesses (LDM/STM/LDRD/STRD) always fault when unaligned. Always 1 on ARMv6-M.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DIV_0_TRP</name>
              <description>1 = SDIV/UDIV by zero raises a DIVBYZERO UsageFault; 0 = the result is 0.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BFHFNMIGN</name>
              <description>Bus faults ignored at priority -1/-2: 1 = precise data BusFaults are ignored (the load returns 0, the store is dropped) in HardFault, NMI and FAULTMASK handlers. Used by probing code that must not lock up.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STKOFHFNMIGN</name>
              <description>Stack overflow ignored at priority -1/-2 (ARMv8-M): 1 = stack limit checks are disabled while executing at HardFault/NMI priority.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DC</name>
              <description>Data cache enable. Invalidate the cache before enabling (SCB_EnableDCache does this); clean before disabling.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IC</name>
              <description>Instruction cache enable. Invalidate before enabling (SCB_EnableICache).</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BP</name>
              <description>Branch prediction enable. Reads as 1 (RAO) on Cortex-M7; on ARMv8-M cores it is implementation defined whether it is writable.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOB</name>
              <description>Loop and branch info cache enable (ARMv8.1-M low-overhead-branch extension). Reset value 1 where implemented.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRD</name>
              <description>Thread reentrancy disabled (ARMv8.1-M): 1 = an exception return to Thread mode while Thread mode is already active in the exception stack (re-entry) is faulted with INVPC; 0 = allowed.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHPR1</name>
          <description>System Handler Priority Register 1: priorities of MemManage, BusFault, UsageFault and SecureFault. Only the top nvicPrioBits of each byte are implemented.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_4</name>
              <description>Priority of system handler 4, MemManage.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_5</name>
              <description>Priority of system handler 5, BusFault.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_6</name>
              <description>Priority of system handler 6, UsageFault.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_7</name>
              <description>Priority of system handler 7, SecureFault (Security Extension only).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHPR2</name>
          <description>System Handler Priority Register 2: priority of SVCall. Only the top nvicPrioBits of each byte are implemented.</description>
          <addressOffset>0x01C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_11</name>
              <description>Priority of system handler 11, SVCall.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHPR3</name>
          <description>System Handler Priority Register 3: priorities of DebugMonitor, PendSV and SysTick. Only the top nvicPrioBits of each byte are implemented.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRI_12</name>
              <description>Priority of system handler 12, DebugMonitor.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_14</name>
              <description>Priority of system handler 14, PendSV.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PRI_15</name>
              <description>Priority of system handler 15, SysTick.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SHCSR</name>
          <description>System Handler Control and State Register: enable bits for the configurable fault exceptions and the active/pending state of every system handler. A configurable fault whose enable bit is 0 escalates to HardFault.</description>
          <addressOffset>0x024</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>MEMFAULTACT</name>
              <description>MemManage exception active. Software may write the active bits to fix up exception state, but must usually leave them alone.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSFAULTACT</name>
              <description>BusFault exception active.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HARDFAULTACT</name>
              <description>HardFault exception active (ARMv8-M).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USGFAULTACT</name>
              <description>UsageFault exception active.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SECUREFAULTACT</name>
              <description>SecureFault exception active (Security Extension).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NMIACT</name>
              <description>NMI exception active (ARMv8-M).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SVCALLACT</name>
              <description>SVCall exception active.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MONITORACT</name>
              <description>DebugMonitor exception active.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PENDSVACT</name>
              <description>PendSV exception active.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSTICKACT</name>
              <description>SysTick exception active.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USGFAULTPENDED</name>
              <description>UsageFault pending (a higher-priority exception is running).</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MEMFAULTPENDED</name>
              <description>MemManage pending.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSFAULTPENDED</name>
              <description>BusFault pending.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SVCALLPENDED</name>
              <description>SVCall pending.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MEMFAULTENA</name>
              <description>MemManage exception enable: 0 = an MPU fault escalates to HardFault (HFSR.FORCED).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSFAULTENA</name>
              <description>BusFault exception enable: 0 = bus errors escalate to HardFault.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USGFAULTENA</name>
              <description>UsageFault exception enable: 0 = undefined instructions, invalid state, NOCP, divide-by-zero etc. escalate to HardFault.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SECUREFAULTENA</name>
              <description>SecureFault exception enable: 0 = security violations escalate to (Secure) HardFault.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SECUREFAULTPENDED</name>
              <description>SecureFault pending.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HARDFAULTPENDED</name>
              <description>HardFault pending (ARMv8-M).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CFSR</name>
          <description>Configurable Fault Status Register: MemManage (bits [7:0]), BusFault ([15:8]) and UsageFault ([31:16]) status. Bits are sticky and write-1-to-clear. With HFSR.FORCED set, this register holds the cause of the escalated HardFault.</description>
          <addressOffset>0x028</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IACCVIOL</name>
              <description>MemManage: instruction fetch from an address the MPU forbids (XN region, no execute permission, or a privileged-only region in unprivileged mode). MMFAR is not written.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DACCVIOL</name>
              <description>MemManage: data access to an address the MPU forbids. MMFAR holds the address when MMARVALID is set; the stacked PC is the faulting instruction.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MUNSTKERR</name>
              <description>MemManage while unstacking on exception return - the stack pointer or an MPU region was changed during the handler.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MSTKERR</name>
              <description>MemManage while stacking on exception entry - typically a stack overflow into a region the MPU forbids (e.g. a guard region below a thread stack).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MLSPERR</name>
              <description>MemManage during lazy floating-point state preservation (the FP frame at FPCAR is in a forbidden region).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MMARVALID</name>
              <description>MMFAR holds a valid fault address. Read MMFAR before clearing this bit.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBUSERR</name>
              <description>BusFault on an instruction prefetch - executing from unmapped or faulting memory (corrupted PC/LR, wrong VTOR, jump through a bad function pointer).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRECISERR</name>
              <description>Precise data BusFault: the stacked PC is the faulting load/store and BFAR holds the address (when BFARVALID).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IMPRECISERR</name>
              <description>Imprecise data BusFault: a buffered write failed after the instruction retired, so the stacked PC is somewhere after the faulting store and BFAR is not valid. Set ACTLR.DISDEFWBUF (Cortex-M3/M4) or add a DSB after suspect stores to make it precise.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UNSTKERR</name>
              <description>BusFault while unstacking on exception return (stack pointer corrupted or pointing at unmapped memory).</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STKERR</name>
              <description>BusFault while stacking on exception entry - the stack pointer points at unmapped memory (stack overflow past the end of RAM, uninitialised SP).</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSPERR</name>
              <description>BusFault during lazy floating-point state preservation.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BFARVALID</name>
              <description>BFAR holds a valid fault address (precise faults only). Read BFAR before clearing this bit.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UNDEFINSTR</name>
              <description>UsageFault: undefined instruction - an unknown opcode (corrupted code, wrong instruction set, an FP/DSP/MVE instruction the core lacks), or a coprocessor instruction on ARMv8-M without CDE.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INVSTATE</name>
              <description>UsageFault: invalid EPSR state - almost always a branch to an address with bit 0 clear (Thumb bit not set), e.g. a null or corrupted function pointer, or a vector table entry without |1.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INVPC</name>
              <description>UsageFault: invalid PC load on exception return - a corrupted EXC_RETURN in LR, or an exception return inconsistent with the active exception state.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NOCP</name>
              <description>UsageFault: no coprocessor - an FPU/MVE or coprocessor instruction while the unit is disabled (SCB.CPACR CP10/CP11, NSACR, CPPWR) or absent. The usual cause of 'HardFault at first float operation'.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STKOF</name>
              <description>UsageFault: stack overflow - a push crossed the MSPLIM/PSPLIM stack limit (ARMv8-M).</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UNALIGNED</name>
              <description>UsageFault: unaligned access with CCR.UNALIGN_TRP set, or an unaligned multi-word access (LDM/STM/LDRD/STRD, exclusive or MVE vector access) which always faults.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DIVBYZERO</name>
              <description>UsageFault: SDIV or UDIV by zero with CCR.DIV_0_TRP set.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>HFSR</name>
          <description>HardFault Status Register: why a HardFault was taken - vector table read error, escalation of a configurable fault (see CFSR) or a debug event. Write 1 to clear.</description>
          <addressOffset>0x02C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VECTTBL</name>
              <description>A bus error occurred reading the vector table during exception entry - VTOR points at unmapped memory, or the table is missing/corrupted.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FORCED</name>
              <description>Escalated fault: a MemManage, BusFault, UsageFault or SecureFault that was disabled (SHCSR) or of insufficient priority became a HardFault. CFSR/SFSR still hold the original cause.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEBUGEVT</name>
              <description>A debug event caused the HardFault - e.g. a BKPT instruction executed with no debugger attached and DEMCR.MON_EN clear, or a vector catch. See DFSR.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DFSR</name>
          <description>Debug Fault Status Register: which debug event occurred (halt, breakpoint, watchpoint, vector catch, external request). Sticky, write 1 to clear.</description>
          <addressOffset>0x030</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>HALTED</name>
              <description>Halt requested by the debugger (DHCSR.C_HALT or C_STEP), a DebugMonitor step, or a PMU/EDBGRQ halt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BKPT</name>
              <description>Breakpoint: a BKPT instruction was executed or an FPB comparator matched.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DWTTRAP</name>
              <description>A DWT watchpoint (data or address comparator) matched.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VCATCH</name>
              <description>A vector catch fired (one of the DEMCR.VC_* bits): the processor halted on entry to the matching exception.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXTERNAL</name>
              <description>External debug request (the EDBGRQ input, typically driven by the CTI).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PMU</name>
              <description>PMU counter overflow caused a debug event (ARMv8.1-M, DHCSR.C_PMOV).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MMFAR</name>
          <description>MemManage Fault Address Register: the data address that caused a MemManage fault, valid when CFSR.MMARVALID is set.</description>
          <addressOffset>0x034</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Data address of the MemManage fault (valid when CFSR.MMARVALID = 1).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BFAR</name>
          <description>BusFault Address Register: the data address of a precise BusFault, valid when CFSR.BFARVALID is set. Not updated for imprecise faults.</description>
          <addressOffset>0x038</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Data address of the precise BusFault (valid when CFSR.BFARVALID = 1).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AFSR</name>
          <description>Auxiliary Fault Status Register: implementation-defined fault status (Cortex-M7 reports AXI/TCM/AHBP errors here and in ABFSR). Write 1 to clear.</description>
          <addressOffset>0x03C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IMPDEF</name>
              <description>Implementation-defined auxiliary fault flags; write 1 to clear.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ID_PFR%s</name>
          <description>Processor Feature Register n: ID_PFR0 lists the supported instruction sets (Thumb, Thumb-2), ID_PFR1 the programmers model (M-profile, Security Extension). Read-only.</description>
          <addressOffset>0x040</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ID_DFR</name>
          <description>Debug Feature Register: the debug model implemented (M-profile debug, Unprivileged Debug Extension). Read-only.</description>
          <addressOffset>0x048</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MProfDbg</name>
              <description>M-profile debug model: 0x1 = M-profile debug v1 (ARMv7-M/v8.0-M), 0x2 = v2 (ARMv8.1-M).</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>UDE</name>
              <description>Unprivileged Debug Extension (ARMv8.1-M): 0x1 = implemented.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ID_AFR</name>
          <description>Auxiliary Feature Register: implementation-defined features. Read-only.</description>
          <addressOffset>0x04C</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ID_MMFR%s</name>
          <description>Memory Model Feature Register n: PMSA support, cache and TCM features, alignment and barrier support. Read-only.</description>
          <addressOffset>0x050</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <dim>6</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ID_ISAR%s</name>
          <description>Instruction Set Attribute Register n: which instruction classes are implemented (e.g. ID_ISAR5 for the SIMD/MVE and FP features on ARMv8.1-M). Read-only.</description>
          <addressOffset>0x060</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>CLIDR</name>
          <description>Cache Level ID Register: which caches exist at each level and the levels of coherence and unification. Read-only.</description>
          <addressOffset>0x078</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CTYPE1</name>
              <description>Cache type at level 1: 0 none, 1 instruction only, 2 data only, 3 separate instruction and data, 4 unified.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>LOC</name>
              <description>Level of Coherence: the number of cache levels to clean/invalidate for coherence with the point of coherency (1 = L1 only).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>LOUU</name>
              <description>Level of Unification Uniprocessor: the number of cache levels to clean for instruction/data unification (1 = L1 only).</description>
              <bitOffset>27</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTR</name>
          <description>Cache Type Register: minimum instruction and data cache line sizes and the exclusives/write-back granules. Read-only.</description>
          <addressOffset>0x07C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>IMINLINE</name>
              <description>Log2 of the number of words in the smallest instruction cache line (3 = 32 bytes on Cortex-M7/M55/M85).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DMINLINE</name>
              <description>Log2 of the number of words in the smallest data cache line (3 = 32 bytes).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ERG</name>
              <description>Exclusives Reservation Granule: log2 words of the reservation granule of LDREX/STREX (0 = unknown).</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CWG</name>
              <description>Cache Writeback Granule: log2 words of the maximum size written back by a clean (0 = unknown).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FORMAT</name>
              <description>Register format: 0b100 = ARMv7 CTR format.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CCSIDR</name>
          <description>Cache Size ID Register: line size, associativity, number of sets and write policies of the cache selected by CSSELR. Read-only.</description>
          <addressOffset>0x080</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>LINESIZE</name>
              <description>Log2(words per cache line) - 2: 1 = 32-byte lines.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>ASSOCIATIVITY</name>
              <description>Associativity - 1 (number of ways - 1; Cortex-M7: 1 for the 2-way I-cache, 3 for the 4-way D-cache).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
            <field>
              <name>NUMSETS</name>
              <description>Number of sets - 1. Cache size = (NUMSETS+1) x (ASSOCIATIVITY+1) x line size.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>15</bitWidth>
            </field>
            <field>
              <name>WA</name>
              <description>Write-allocation supported.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RA</name>
              <description>Read-allocation supported.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WB</name>
              <description>Write-back supported.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WT</name>
              <description>Write-through supported.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CSSELR</name>
          <description>Cache Size Selection Register: selects which cache (level, instruction or data) CCSIDR describes.</description>
          <addressOffset>0x084</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IND</name>
              <description>Instruction not data: 0 = data or unified cache, 1 = instruction cache is described by CCSIDR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LEVEL</name>
              <description>Cache level - 1 (0 = level 1).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CPACR</name>
          <description>Coprocessor Access Control Register: access rights for coprocessors 0-7 and for the FPU/MVE (CP10 and CP11, which must be set identically). An FP instruction with CP10/CP11 = 0 raises a NOCP UsageFault - the classic 'FPU not enabled' HardFault.</description>
          <addressOffset>0x088</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CP0</name>
              <description>Access rights for coprocessor 0: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP1</name>
              <description>Access rights for coprocessor 1: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP2</name>
              <description>Access rights for coprocessor 2: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP3</name>
              <description>Access rights for coprocessor 3: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP4</name>
              <description>Access rights for coprocessor 4: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP5</name>
              <description>Access rights for coprocessor 5: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP6</name>
              <description>Access rights for coprocessor 6: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP7</name>
              <description>Access rights for coprocessor 7: 0 = denied (NOCP UsageFault), 1 = privileged only, 3 = full access.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP10</name>
              <description>FPU/MVE access (CP10): 0 = denied - any FP instruction raises a NOCP UsageFault/HardFault, 1 = privileged only, 3 = full access. Must equal CP11.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CP11</name>
              <description>FPU/MVE access (CP11): must be set identically to CP10.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>NSACR</name>
          <description>Non-secure Access Control Register (Security Extension): which coprocessors Non-secure software may use. Secure access only.</description>
          <addressOffset>0x08C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CP0</name>
              <description>1 = Non-secure software may use coprocessor 0 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP1</name>
              <description>1 = Non-secure software may use coprocessor 1 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP2</name>
              <description>1 = Non-secure software may use coprocessor 2 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP3</name>
              <description>1 = Non-secure software may use coprocessor 3 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP4</name>
              <description>1 = Non-secure software may use coprocessor 4 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP5</name>
              <description>1 = Non-secure software may use coprocessor 5 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP6</name>
              <description>1 = Non-secure software may use coprocessor 6 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP7</name>
              <description>1 = Non-secure software may use coprocessor 7 (custom datapath extension / CDE coprocessor).</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP10</name>
              <description>1 = Non-secure software may use the FPU/MVE (CP10). Must equal CP11.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CP11</name>
              <description>1 = Non-secure software may use the FPU/MVE (CP11). Must equal CP10.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SFSR</name>
          <description>SecureFault Status Register (Security Extension): why a SecureFault was taken. Sticky, write 1 to clear. Secure access only.</description>
          <addressOffset>0x0E4</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>INVEP</name>
              <description>Invalid entry point: a Non-secure branch into Secure code that did not land on an SG instruction in a Non-secure-callable region.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INVIS</name>
              <description>Invalid integrity signature: the Secure exception frame being unstacked has a wrong integrity signature (stack corruption or wrong stack).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INVER</name>
              <description>Invalid exception return: the EXC_RETURN or the exception stack does not match the security state (e.g. a Non-secure return from a Secure handler).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AUVIOL</name>
              <description>Attribution unit violation: a Non-secure access to an address the SAU/IDAU marks Secure. SFAR holds the address when SFARVALID is set.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INVTRAN</name>
              <description>Invalid transition: a Secure-to-Non-secure branch not made with BXNS/BLXNS (for example calling a Non-secure function pointer directly, or a return to Non-secure code via a plain BX).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSPERR</name>
              <description>Error during lazy floating-point state preservation across security states.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SFARVALID</name>
              <description>SFAR holds a valid address (AUVIOL faults).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSERR</name>
              <description>Lazy state error: a Secure FP/MVE context could not be saved or restored across the security transition.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SFAR</name>
          <description>SecureFault Address Register: the address that caused an AUVIOL SecureFault, valid when SFSR.SFARVALID is set.</description>
          <addressOffset>0x0E8</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Address of the SecureFault (valid when SFSR.SFARVALID = 1).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RFSR</name>
          <description>RAS Fault Status Register (ARMv8.1-M RAS extension): records the most recent uncontained error. Write to clear.</description>
          <addressOffset>0x204</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>UET</name>
              <description>Uncontainable error type: 0 = UC uncontainable, 1 = UEU unrecoverable, 2 = UEO restartable, 3 = UER recoverable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>IS</name>
              <description>Implementation-specific syndrome of the recorded error.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>15</bitWidth>
            </field>
            <field>
              <name>V</name>
              <description>Valid: 1 = a RAS error has been recorded in this register.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ICIALLU</name>
          <description>Instruction Cache Invalidate All to PoU: write any value to invalidate the whole instruction cache (and branch predictor). Write-only.</description>
          <addressOffset>0x250</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>ICIMVAU</name>
          <description>Instruction Cache Invalidate by address to PoU: write an address to invalidate the I-cache line containing it. Write-only.</description>
          <addressOffset>0x258</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Any address inside the instruction cache line to invalidate.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCIMVAC</name>
          <description>Data Cache Invalidate by address to PoC: write an address to invalidate (discard) the D-cache line containing it. Write-only.</description>
          <addressOffset>0x25C</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Any address inside the data cache line to invalidate.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCISW</name>
          <description>Data Cache Invalidate by Set/Way: write a set and way (see fields) to invalidate that line. Write-only.</description>
          <addressOffset>0x260</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>SET</name>
              <description>Set index of the cache line (number of sets from CCSIDR).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>WAY</name>
              <description>Way of the cache line (0-3 on the 4-way Cortex-M7 data cache).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCCMVAU</name>
          <description>Data Cache Clean by address to PoU: write an address to clean (write back) the line containing it to the point of unification. Write-only.</description>
          <addressOffset>0x264</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Any address inside the data cache line to clean to the point of unification.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCCMVAC</name>
          <description>Data Cache Clean by address to PoC: write an address to clean (write back) the line containing it to the point of coherency. Write-only.</description>
          <addressOffset>0x268</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Any address inside the data cache line to clean to the point of coherency.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCCSW</name>
          <description>Data Cache Clean by Set/Way: write a set and way to clean that line. Write-only.</description>
          <addressOffset>0x26C</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>SET</name>
              <description>Set index of the cache line.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>WAY</name>
              <description>Way of the cache line.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCCIMVAC</name>
          <description>Data Cache Clean and Invalidate by address to PoC: write an address to write back and then invalidate its line. Write-only.</description>
          <addressOffset>0x270</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Any address inside the data cache line to clean and invalidate.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCCISW</name>
          <description>Data Cache Clean and Invalidate by Set/Way. Write-only.</description>
          <addressOffset>0x274</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>SET</name>
              <description>Set index of the cache line.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>WAY</name>
              <description>Way of the cache line.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BPIALL</name>
          <description>Branch Predictor Invalidate All: write any value to invalidate all branch predictor state. Write-only.</description>
          <addressOffset>0x278</addressOffset>
          <access>write-only</access>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MPU</name>
      <description>Memory Protection Unit (optional): programmable regions with access permissions and memory attributes, checked on every access. ARMv6-M/v7-M (PMSAv7) use RBAR/RASR power-of-two regions; ARMv8-M (PMSAv8) uses RBAR/RLAR base-limit regions with MAIR attributes.</description>
      <baseAddress>0xE000ED90</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x038</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TYPE</name>
          <description>MPU Type Register: how many regions the MPU implements (0 = no MPU). Read-only.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SEPARATE</name>
              <description>0 = unified MPU (instruction and data share the regions). Always 0 on Cortex-M.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DREGION</name>
              <description>Number of MPU regions implemented (0 = no MPU; Cortex-M cores offer 8 or 16).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IREGION</name>
              <description>Number of instruction regions; always 0 (unified).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>MPU Control Register: global enable, behaviour during HardFault/NMI, and the privileged default memory map.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>MPU enable. When 0 the default memory map applies to all accesses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HFNMIENA</name>
              <description>1 = the MPU stays enabled during HardFault, NMI and FAULTMASK handlers; 0 = those handlers use the default memory map (the usual choice).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PRIVDEFENA</name>
              <description>1 = privileged accesses to addresses not covered by any enabled region use the default memory map; 0 = they raise a MemManage fault (unprivileged accesses always fault).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RNR</name>
          <description>MPU Region Number Register: selects the region that RBAR and RASR/RLAR access.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>REGION</name>
              <description>Region number selected for RBAR/RASR (RLAR) accesses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR</name>
          <description>MPU Region Base Address Register for the region selected by RNR (ARMv7-M: also selects the region when VALID is set). ARMv8-M: base address, shareability, access permissions and XN.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>XN</name>
              <description>Execute never: 1 = instruction fetches from this region fault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AP</name>
              <description>Access permissions: 0 = read/write privileged only, 1 = read/write any privilege, 2 = read-only privileged only, 3 = read-only any privilege.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RW_PRIV</name>
                  <description>Read/write, privileged only</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RW_ANY</name>
                  <description>Read/write, any privilege</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_PRIV</name>
                  <description>Read-only, privileged only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_ANY</name>
                  <description>Read-only, any privilege</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SH</name>
              <description>Shareability of Normal memory: 0 = non-shareable, 2 = outer shareable, 3 = inner shareable (1 reserved). Ignored for Device memory.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NonShareable</name>
                  <description>Non-shareable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OuterShareable</name>
                  <description>Outer shareable</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>InnerShareable</name>
                  <description>Inner shareable</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BASE</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR</name>
          <description>MPU Region Limit Address Register (ARMv8-M PMSAv8): inclusive end address, attribute index into MAIR0/1 and enable of the selected region.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AttrIndx</name>
              <description>Index (0-7) of the MAIR0/MAIR1 attribute byte that gives the memory type and cacheability of this region.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PXN</name>
              <description>Privileged execute never (ARMv8.1-M): 1 = privileged instruction fetches from this region fault.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LIMIT</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1, so the region is inclusive up to LIMIT + 31.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR_A1</name>
          <description>Alias of RBAR that accesses region RNR+1, so up to four regions can be programmed with a single STM. Same fields as RBAR.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>XN</name>
              <description>Execute never: 1 = instruction fetches from this region fault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AP</name>
              <description>Access permissions: 0 = read/write privileged only, 1 = read/write any privilege, 2 = read-only privileged only, 3 = read-only any privilege.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RW_PRIV</name>
                  <description>Read/write, privileged only</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RW_ANY</name>
                  <description>Read/write, any privilege</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_PRIV</name>
                  <description>Read-only, privileged only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_ANY</name>
                  <description>Read-only, any privilege</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SH</name>
              <description>Shareability of Normal memory: 0 = non-shareable, 2 = outer shareable, 3 = inner shareable (1 reserved). Ignored for Device memory.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NonShareable</name>
                  <description>Non-shareable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OuterShareable</name>
                  <description>Outer shareable</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>InnerShareable</name>
                  <description>Inner shareable</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BASE</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR_A1</name>
          <description>Alias of RLAR that accesses region RNR+1. Same fields as RLAR.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AttrIndx</name>
              <description>Index (0-7) of the MAIR0/MAIR1 attribute byte that gives the memory type and cacheability of this region.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PXN</name>
              <description>Privileged execute never (ARMv8.1-M): 1 = privileged instruction fetches from this region fault.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LIMIT</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1, so the region is inclusive up to LIMIT + 31.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR_A2</name>
          <description>Alias of RBAR that accesses region RNR+2. Same fields as RBAR.</description>
          <addressOffset>0x01C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>XN</name>
              <description>Execute never: 1 = instruction fetches from this region fault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AP</name>
              <description>Access permissions: 0 = read/write privileged only, 1 = read/write any privilege, 2 = read-only privileged only, 3 = read-only any privilege.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RW_PRIV</name>
                  <description>Read/write, privileged only</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RW_ANY</name>
                  <description>Read/write, any privilege</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_PRIV</name>
                  <description>Read-only, privileged only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_ANY</name>
                  <description>Read-only, any privilege</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SH</name>
              <description>Shareability of Normal memory: 0 = non-shareable, 2 = outer shareable, 3 = inner shareable (1 reserved). Ignored for Device memory.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NonShareable</name>
                  <description>Non-shareable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OuterShareable</name>
                  <description>Outer shareable</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>InnerShareable</name>
                  <description>Inner shareable</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BASE</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR_A2</name>
          <description>Alias of RLAR that accesses region RNR+2. Same fields as RLAR.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AttrIndx</name>
              <description>Index (0-7) of the MAIR0/MAIR1 attribute byte that gives the memory type and cacheability of this region.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PXN</name>
              <description>Privileged execute never (ARMv8.1-M): 1 = privileged instruction fetches from this region fault.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LIMIT</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1, so the region is inclusive up to LIMIT + 31.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR_A3</name>
          <description>Alias of RBAR that accesses region RNR+3. Same fields as RBAR.</description>
          <addressOffset>0x024</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>XN</name>
              <description>Execute never: 1 = instruction fetches from this region fault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AP</name>
              <description>Access permissions: 0 = read/write privileged only, 1 = read/write any privilege, 2 = read-only privileged only, 3 = read-only any privilege.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RW_PRIV</name>
                  <description>Read/write, privileged only</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RW_ANY</name>
                  <description>Read/write, any privilege</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_PRIV</name>
                  <description>Read-only, privileged only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RO_ANY</name>
                  <description>Read-only, any privilege</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SH</name>
              <description>Shareability of Normal memory: 0 = non-shareable, 2 = outer shareable, 3 = inner shareable (1 reserved). Ignored for Device memory.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NonShareable</name>
                  <description>Non-shareable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OuterShareable</name>
                  <description>Outer shareable</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>InnerShareable</name>
                  <description>Inner shareable</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BASE</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR_A3</name>
          <description>Alias of RLAR that accesses region RNR+3. Same fields as RLAR.</description>
          <addressOffset>0x028</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AttrIndx</name>
              <description>Index (0-7) of the MAIR0/MAIR1 attribute byte that gives the memory type and cacheability of this region.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PXN</name>
              <description>Privileged execute never (ARMv8.1-M): 1 = privileged instruction fetches from this region fault.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LIMIT</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1, so the region is inclusive up to LIMIT + 31.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MAIR0</name>
          <description>MPU Memory Attribute Indirection Register 0: memory type/cacheability encodings 0-3 referenced by RLAR.AttrIndx.</description>
          <addressOffset>0x030</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>Attr0</name>
              <description>Memory attribute encoding 0, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr1</name>
              <description>Memory attribute encoding 1, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr2</name>
              <description>Memory attribute encoding 2, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr3</name>
              <description>Memory attribute encoding 3, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MAIR1</name>
          <description>MPU Memory Attribute Indirection Register 1: memory type/cacheability encodings 4-7 referenced by RLAR.AttrIndx.</description>
          <addressOffset>0x034</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>Attr4</name>
              <description>Memory attribute encoding 4, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr5</name>
              <description>Memory attribute encoding 5, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr6</name>
              <description>Memory attribute encoding 6, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>Attr7</name>
              <description>Memory attribute encoding 7, selected by RLAR.AttrIndx: Device memory = 0b0000dd00 (dd: 00 nGnRnE, 01 nGnRE, 10 nGRE, 11 GRE); Normal memory = outer[7:4] inner[3:0] with 0100 non-cacheable, 10RW write-through, 11RW write-back (R = read-allocate, W = write-allocate; 1111 = write-back RWA).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SAU</name>
      <description>Security Attribution Unit (ARMv8-M Security Extension): defines which address ranges are Non-secure or Secure Non-secure-callable; everything else is Secure. Also holds the SecureFault status and address registers.</description>
      <baseAddress>0xE000EDD0</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x014</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>SAU Control Register: enable, and what the memory map looks like while the SAU is disabled.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>SAU enable. When 0 the whole address space is Secure (ALLNS = 0) or Non-secure (ALLNS = 1), subject to the IDAU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALLNS</name>
              <description>All Non-secure: with the SAU disabled, 1 = memory not marked Secure by the IDAU is Non-secure, 0 = all memory is Secure.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TYPE</name>
          <description>SAU Type Register: number of SAU regions implemented (0, 4 or 8 on Arm cores). Read-only.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SREGION</name>
              <description>Number of SAU regions implemented (0, 4 or 8).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RNR</name>
          <description>SAU Region Number Register: selects the region that RBAR and RLAR access.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>REGION</name>
              <description>Region selected for RBAR/RLAR accesses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RBAR</name>
          <description>SAU Region Base Address Register: start address (32-byte aligned) of the selected region.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>BADDR</name>
              <description>Region start address bits [31:5] (32-byte granularity).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RLAR</name>
          <description>SAU Region Limit Address Register: inclusive end address, Non-secure-callable attribute and enable of the selected region.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NSC</name>
              <description>1 = the region is Secure and Non-secure-callable (holds the SG entry veneers); 0 = the region is Non-secure.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LADDR</name>
              <description>Region end address bits [31:5]; the low five bits are treated as 1 (inclusive limit).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DCB</name>
      <description>Debug Control Block: halting debug control and status (DHCSR), core register access from the debugger (DCRSR/DCRDR), vector catch, the DebugMonitor exception and trace enable (DEMCR), and on ARMv8-M debug authentication and security control.</description>
      <baseAddress>0xE000EDF0</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x01C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DHCSR</name>
          <description>Debug Halting Control and Status Register: debugger enable, halt, step and interrupt masking (writes need 0xA05F in bits [31:16], DBGKEY), and read-only processor status (halted, sleeping, locked up, reset since last read) in the same upper bits.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>C_DEBUGEN</name>
              <description>Halting debug enable. Set by the debugger; cannot be set by software. While 0 the other C_* bits are ignored and BKPT with no monitor escalates to HardFault.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_HALT</name>
              <description>Halt request: 1 = halt the processor (Debug state); 0 = run. Needs C_DEBUGEN = 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_STEP</name>
              <description>Single step: 1 = when leaving Debug state, execute one instruction and halt again.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_MASKINTS</name>
              <description>Mask PendSV, SysTick and IRQ (not NMI/faults) while stepping, so a step does not enter an interrupt handler. Change only while halted, together with C_HALT.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_SNAPSTALL</name>
              <description>1 = force the processor out of a stalled load/store (bus never responded). The instruction is abandoned, not restarted - the state afterwards is unpredictable; a reset is usually needed.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C_PMOV</name>
              <description>Halt on PMU overflow (ARMv8.1-M): 1 = a PMU counter overflow generates a halt debug event (DFSR.PMU).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S_REGRDY</name>
              <description>Register transfer complete: a DCRSR read/write has finished and DCRDR is valid. Read-only.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_HALT</name>
              <description>Processor is in Debug state (halted). Read-only.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_SLEEP</name>
              <description>Processor is sleeping (WFI, WFE or sleep-on-exit). Read-only.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_LOCKUP</name>
              <description>Processor is in lockup state - a fault occurred at priority -1 or in NMI/HardFault with no way to escalate; PC reads 0xFFFFFFFE. Read-only.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_SDE</name>
              <description>Secure debug enabled: 1 = halting debug is permitted in Secure state (DAUTHSTATUS.SID). Read-only.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_NSUIDE</name>
              <description>Non-secure unprivileged invasive debug enabled (ARMv8.1-M UDE). Read-only.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_SUIDE</name>
              <description>Secure unprivileged invasive debug enabled (ARMv8.1-M UDE). Read-only.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_FPD</name>
              <description>Floating-point debuggable: 0 = the FP/MVE registers are not accessible to the debugger (unit powered down or Secure-only). Read-only (ARMv8.1-M).</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_RETIRE_ST</name>
              <description>Sticky: at least one instruction retired since the last read of DHCSR. Cleared on read.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_RESET_ST</name>
              <description>Sticky: the processor was reset since the last read of DHCSR. Cleared on read.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>S_RESTART_ST</name>
              <description>Sticky: the processor left Debug state (restarted) since the last read (ARMv8-M). Cleared on read.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DCRSR</name>
          <description>Debug Core Register Selector Register: with the processor halted, selects a core register to transfer to or from DCRDR. Poll DHCSR.S_REGRDY for completion.</description>
          <addressOffset>0x004</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>REGSEL</name>
              <description>Register to transfer: 0-12 R0-R12, 13 SP (current), 14 LR, 15 DebugReturnAddress (PC), 16 xPSR, 17 MSP, 18 PSP, 20 packed CONTROL[31:24] FAULTMASK[16] BASEPRI[8] PRIMASK[0], 33 FPSCR, 64-95 S0-S31; ARMv8-M: 24 MSP_NS, 25 PSP_NS, 26 MSP_S, 27 PSP_S, 28 MSPLIM_S, 29 PSPLIM_S, 30 MSPLIM_NS, 31 PSPLIM_NS, 34/35 packed CONTROL/masks _S/_NS.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>REGWnR</name>
              <description>Direction: 0 = read the selected register into DCRDR, 1 = write DCRDR to the selected register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCRDR</name>
          <description>Debug Core Register Data Register: data for DCRSR transfers. Also usable as a general debugger-to-target mailbox.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>DBGTMP</name>
              <description>Data read from, or to be written to, the register selected by DCRSR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEMCR</name>
          <description>Debug Exception and Monitor Control Register: vector catch on reset and faults, DebugMonitor exception control, and TRCENA, the global enable for DWT, ITM, ETM and TPIU.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VC_CORERESET</name>
              <description>Vector catch on core reset: halt immediately after reset (the 'reset catch' debuggers use to stop at the first instruction). Needs C_DEBUGEN.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_MMERR</name>
              <description>Vector catch on MemManage fault entry.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_NOCPERR</name>
              <description>Vector catch on a NOCP (no coprocessor) UsageFault.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_CHKERR</name>
              <description>Vector catch on a checking-error UsageFault (UNALIGNED, DIVBYZERO).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_STATERR</name>
              <description>Vector catch on a state-error UsageFault (UNDEFINSTR, INVSTATE, INVPC).</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_BUSERR</name>
              <description>Vector catch on BusFault entry.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_INTERR</name>
              <description>Vector catch on a fault during exception entry or return (stacking/unstacking errors, INVPC on return).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_HARDERR</name>
              <description>Vector catch on HardFault entry - with this set the core halts at the fault instead of running the HardFault handler.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VC_SFERR</name>
              <description>Vector catch on SecureFault entry (Security Extension).</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MON_EN</name>
              <description>DebugMonitor exception enable: with no halting debugger attached, BKPT, FPB and DWT events raise the DebugMonitor exception (12) instead of a HardFault.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MON_PEND</name>
              <description>Set the DebugMonitor exception pending (software or debugger can use it to enter the monitor).</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MON_STEP</name>
              <description>Monitor step: 1 = after the monitor returns, execute one instruction and re-enter the monitor (software single-step).</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MON_REQ</name>
              <description>Monitor request semaphore: set by software to tell the monitor handler it was entered by request rather than by a debug event (not affected by hardware).</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDME</name>
              <description>Secure DebugMonitor enable: 1 = the DebugMonitor exception targets Secure state. Read-only status derived from the debug authentication signals.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UMON_EN</name>
              <description>Unprivileged monitor enable (ARMv8.1-M UDE): 1 = the DebugMonitor may be used for unprivileged debug.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MONPRKEY</name>
              <description>Monitor pending request key (ARMv8.1-M): a write to MON_PEND takes effect only if this bit is written as 1 in the same access.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRCENA</name>
              <description>Trace enable: global enable for the DWT, ITM, ETM and TPIU. Must be 1 before any DWT/ITM register is written (CYCCNT, watchpoints, SWO output).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DSCEMCR</name>
          <description>Debug Set/Clear Exception and Monitor Control Register (ARMv8.1-M): atomic set/clear access to the DEMCR MON_PEND and MON_REQ bits.</description>
          <addressOffset>0x010</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>SET_MON_PEND</name>
              <description>Write 1 to set DEMCR.MON_PEND.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SET_MON_REQ</name>
              <description>Write 1 to set DEMCR.MON_REQ.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLR_MON_PEND</name>
              <description>Write 1 to clear DEMCR.MON_PEND.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLR_MON_REQ</name>
              <description>Write 1 to clear DEMCR.MON_REQ.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DAUTHCTRL</name>
          <description>Debug Authentication Control Register (ARMv8-M): lets Secure software override the external SPIDEN/SPNIDEN debug authentication inputs.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SPIDENSEL</name>
              <description>1 = INTSPIDEN overrides the external SPIDEN input (Secure invasive debug enable).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTSPIDEN</name>
              <description>Internal Secure invasive debug enable, used when SPIDENSEL = 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SPNIDENSEL</name>
              <description>1 = INTSPNIDEN overrides the external SPNIDEN input (Secure non-invasive debug/trace enable).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTSPNIDEN</name>
              <description>Internal Secure non-invasive debug enable, used when SPNIDENSEL = 1.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FSDMA</name>
              <description>Force Secure DebugMonitor allowed (ARMv8.1-M): 1 = the DebugMonitor is permitted in Secure state regardless of SPIDEN.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UIDAPEN</name>
              <description>Unprivileged invasive debug of the DAP enable (ARMv8.1-M UDE).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UIDEN</name>
              <description>Unprivileged invasive debug enable (ARMv8.1-M UDE): 1 = halting debug is allowed only in unprivileged code.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DSCSR</name>
          <description>Debug Security Control and Status Register (ARMv8-M): the current security state of the core and which banked register set the debugger sees.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SBRSELEN</name>
              <description>Secure banked register select enable: 1 = SBRSEL chooses which security state's banked registers DCRSR accesses; 0 = the current state's.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SBRSEL</name>
              <description>Security state of the banked registers accessed through DCRSR when SBRSELEN = 1: 0 = Non-secure, 1 = Secure.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CDS</name>
              <description>Current domain Secure: 1 = the processor is in Secure state. The debugger may write it (with CDSKEY = 0) while halted to switch state.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CDSKEY</name>
              <description>CDS write key: CDS is only updated if this bit is written as 0 in the same access. Reads as 1.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>FPU</name>
      <description>Floating-Point Unit control: context control (lazy stacking, automatic state preservation), the lazy-stacking frame address, the default FPSCR and the VFP/MVE feature registers. Enable the FPU through SCB.CPACR (CP10/CP11) before use.</description>
      <baseAddress>0xE000EF30</baseAddress>
      <addressBlock>
        <offset>0x004</offset>
        <size>0x018</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FPCCR</name>
          <description>Floating-Point Context Control Register: automatic and lazy FP state preservation on exception entry, and which exceptions may be taken while a lazy save is pending.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <resetValue>0xC0000000</resetValue>
          <fields>
            <field>
              <name>LSPACT</name>
              <description>Lazy state preservation active: an FP context frame is reserved at FPCAR but the registers have not been saved yet. The first FP instruction in the handler triggers the save.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USER</name>
              <description>The reserved FP frame belongs to unprivileged (user) code.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S</name>
              <description>The reserved FP frame belongs to Secure code (Security Extension).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>THREAD</name>
              <description>The reserved FP frame was allocated in Thread mode.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HFRDY</name>
              <description>HardFault ready: 1 = the priority when the frame was reserved allows HardFault to be taken during the lazy save.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MMRDY</name>
              <description>MemManage ready: 1 = MemManage can be taken during the lazy save (it was enabled and of sufficient priority).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BFRDY</name>
              <description>BusFault ready: 1 = BusFault can be taken during the lazy save.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SFRDY</name>
              <description>SecureFault ready: 1 = SecureFault can be taken during the lazy save.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MONRDY</name>
              <description>DebugMonitor ready: 1 = the monitor exception can be taken during the lazy save.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SPLIMVIOL</name>
              <description>Stack pointer limit violation: reserving the FP frame crossed the stack limit (ARMv8-M); the frame was not allocated.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UFRDY</name>
              <description>UsageFault ready: 1 = UsageFault can be taken during the lazy save.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TS</name>
              <description>Treat as Secure: 1 = all FP registers are treated as Secure - all 32 are stacked (and cleared) on Secure-to-Non-secure exception transitions. Secure access only.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLRONRETS</name>
              <description>CLRONRET Secure only: 1 = CLRONRET can only be written from Secure state.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLRONRET</name>
              <description>Clear on return: 1 = the caller-saved FP registers (S0-S15, FPSCR) are cleared on exception return from Secure to Non-secure state.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSPENS</name>
              <description>LSPEN Secure only: 1 = LSPEN can only be written from Secure state.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSPEN</name>
              <description>Lazy state preservation enable: 1 = on exception entry only space is reserved for S0-S15/FPSCR and the registers are saved only if the handler uses the FPU (default, saves ~17 cycles); 0 = always saved.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ASPEN</name>
              <description>Automatic state preservation enable: 1 = executing an FP instruction sets CONTROL.FPCA, so the next exception entry uses the extended (FP) stack frame. Default 1.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FPCAR</name>
          <description>Floating-Point Context Address Register: location of the unpopulated FP register space (S0-S15, FPSCR) in the exception stack frame while FPCCR.LSPACT is set.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDRESS</name>
              <description>Address of the unpopulated S0-S15/FPSCR area in the exception stack frame (8-byte aligned), valid while FPCCR.LSPACT is 1.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FPDSCR</name>
          <description>Floating-Point Default Status Control Register: the FPSCR mode bits (rounding, flush-to-zero, default NaN, alternative half-precision) loaded on exception entry / when a new FP context starts.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>LTPSIZE</name>
              <description>Default loop tail-predication size for MVE (ARMv8.1-M); must be 4 (no tail predication) in this register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>FZ16</name>
              <description>Default flush-to-zero mode for half-precision (ARMv8.1-M).</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RMode</name>
              <description>Default rounding mode: 0 = round to nearest, 1 = towards +infinity, 2 = towards -infinity, 3 = towards zero.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RN</name>
                  <description>Round to nearest</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RP</name>
                  <description>Round towards plus infinity</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RM</name>
                  <description>Round towards minus infinity</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RZ</name>
                  <description>Round towards zero</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FZ</name>
              <description>Default flush-to-zero mode: 1 = denormals are flushed to zero (not IEEE compliant, faster on some cores).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DN</name>
              <description>Default NaN mode: 1 = any NaN result is the default NaN rather than propagating the input NaN.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AHP</name>
              <description>Alternative half-precision: 1 = use the Arm alternative half-precision format (no infinities/NaNs) for conversions.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MVFR0</name>
          <description>Media and VFP Feature Register 0: register bank size, single/double precision, divide, square root and rounding support. Read-only.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SIMDReg</name>
              <description>Register bank: 0x1 = 16 double-precision (S0-S31) registers, 0x2 = 32 double-precision registers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPSP</name>
              <description>Single-precision support: 0 = none, 2 = supported (VFPv3/FPv4/FPv5 level).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPDP</name>
              <description>Double-precision support: 0 = none, 2 = supported (Cortex-M7 with the DP option, Cortex-M55/M85).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPDivide</name>
              <description>VDIV supported: 1 = yes.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPSqrt</name>
              <description>VSQRT supported: 1 = yes.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPRound</name>
              <description>Rounding modes: 1 = all IEEE 754 rounding modes supported.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MVFR1</name>
          <description>Media and VFP Feature Register 1: flush-to-zero, default NaN, half-precision, fused MAC and (ARMv8.1-M) MVE support. Read-only.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>FPFtZ</name>
              <description>Flush-to-zero mode: 1 = supported (FPSCR.FZ).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPDNaN</name>
              <description>Default NaN mode: 1 = supported (FPSCR.DN).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>MVE</name>
              <description>M-profile Vector Extension (Helium): 0 = none, 1 = integer MVE, 2 = integer and floating-point MVE.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FP16</name>
              <description>Half-precision floating-point arithmetic (ARMv8.1-M): 1 = supported.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FPHP</name>
              <description>Half-precision conversions: 1 = single&lt;-&gt;half, 2 = also double&lt;-&gt;half, 3 = full half-precision arithmetic.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FMAC</name>
              <description>Fused multiply-accumulate (VFMA/VFMS/VFNMA/VFNMS): 1 = supported.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MVFR2</name>
          <description>Media and VFP Feature Register 2: miscellaneous FPv5 features (VSEL, VCVT rounding variants, VRINT, VMAXNM/VMINNM). Read-only.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>FPMisc</name>
              <description>Miscellaneous FPv5 features: 0x4 = VSEL, VCVTA/N/P/M, VRINT*, VMAXNM/VMINNM supported.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DIB</name>
      <description>Debug Identification Block (ARMv8-M): software lock, debug authentication status and the SCS CoreSight architecture and type IDs.</description>
      <baseAddress>0xE000EFB0</baseAddress>
      <addressBlock>
        <offset>0x008</offset>
        <size>0x018</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DAUTHSTATUS</name>
          <description>Debug Authentication Status Register: which kinds of debug (invasive/non-invasive, Secure/Non-secure, unprivileged) are currently enabled.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NSID</name>
              <description>Non-secure invasive debug: 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSNID</name>
              <description>Non-secure non-invasive debug (trace): 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SID</name>
              <description>Secure invasive debug: 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SNID</name>
              <description>Secure non-invasive debug: 0 = not implemented, 2 = disabled, 3 = enabled.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSUID</name>
              <description>Non-secure unprivileged invasive debug (ARMv8.1-M UDE): 2 = disabled, 3 = enabled.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSUNID</name>
              <description>Non-secure unprivileged non-invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SUID</name>
              <description>Secure unprivileged invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SUNID</name>
              <description>Secure unprivileged non-invasive debug: 2 = disabled, 3 = enabled.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DDEVARCH</name>
          <description>SCS Device Architecture Register: CoreSight ARCHID of the debug architecture (0x2A04 = ARMv8-M debug) and the architect (Arm, 0x23B).</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ARCHPART</name>
              <description>Architecture part: 0xA04 = M-profile system control space (with ARCHVER 2 -&gt; ARCHID 0x2A04, ARMv8-M debug).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>ARCHVER</name>
              <description>Architecture version: 2 = ARMv8-M debug architecture.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DDEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect: 0x23B = Arm.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DDEVTYPE</name>
          <description>SCS Device Type Register: CoreSight major/sub type of the SCS (0x00 = processor system control).</description>
          <addressOffset>0x01C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 = miscellaneous / processor system control.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type: 0 for the SCS.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MEMSYSCTL</name>
      <description>Memory System Control (Cortex-M55/M85/M52): ECC, cache and prefetcher control, TCM and P-AHB window enables, and the TCM Gate Units (ITGU/DTGU) that assign security attributes to TCM blocks.</description>
      <groupName>MemSysCtl</groupName>
      <baseAddress>0xE001E000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x01C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x500</offset>
        <size>0x050</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x600</offset>
        <size>0x050</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MSCR</name>
          <description>Memory System Control Register: ECC enable, forced write-through, ECC fault reporting, TCM ECC checking and read-only cache status.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ECCEN</name>
              <description>ECC enable for the caches and TCMs.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FORCEWT</name>
              <description>Force write-through: 1 = all cacheable data is cached write-through.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EVECCFAULT</name>
              <description>Enable ECC fault reporting: 1 = an uncorrectable ECC error raises a BusFault (with an error bank entry) instead of being silently poisoned.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TECCCHKDIS</name>
              <description>TCM ECC check disable: 1 = ECC on the TCMs is not checked (still generated).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DCACTIVE</name>
              <description>Data cache active (read-only): 1 = the D-cache is enabled and powered.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ICACTIVE</name>
              <description>Instruction cache active (read-only).</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DCCLEAN</name>
              <description>Data cache clean (read-only): 1 = no dirty lines.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>CPWRDN</name>
              <description>Cache power-down: 1 = the cache RAMs may be powered down when the caches are disabled.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITCMCR</name>
          <description>ITCM Control Register: enable and size of the instruction TCM.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>ITCM enable: 1 = the ITCM responds to accesses in its address range.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SZ</name>
              <description>TCM size: 0 = none, 3 = 4 KB, 4 = 8 KB, 5 = 16 KB, 6 = 32 KB, 7 = 64 KB, 8 = 128 KB, 9 = 256 KB, 10 = 512 KB, 11 = 1 MB, 12 = 2 MB, 13 = 4 MB, 14 = 8 MB, 15 = 16 MB (2^(SZ-1) KB). Read-only.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DTCMCR</name>
          <description>DTCM Control Register: enable and size of the data TCM.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>DTCM enable: 1 = the DTCM responds to accesses in its address range.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SZ</name>
              <description>TCM size: 0 = none, 3 = 4 KB, 4 = 8 KB, 5 = 16 KB, 6 = 32 KB, 7 = 64 KB, 8 = 128 KB, 9 = 256 KB, 10 = 512 KB, 11 = 1 MB, 12 = 2 MB, 13 = 4 MB, 14 = 8 MB, 15 = 16 MB (2^(SZ-1) KB). Read-only.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PAHBCR</name>
          <description>P-AHB Control Register: enable and size of the peripheral AHB window.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>P-AHB enable: 1 = accesses in the P-AHB window use the peripheral AHB port instead of the AXI master.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SZ</name>
              <description>P-AHB window size: 0 = disabled, 1 = 64 MB, 2 = 128 MB, 3 = 256 MB, 4 = 512 MB. Read-only.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ITGU_CTRL</name>
          <description>ITCM Gate Unit Control Register: how ITGU security violations are reported.</description>
          <addressOffset>0x500</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>DBFEN</name>
              <description>Data bus fault enable: 1 = an ITGU security violation raises a BusFault/SecureFault (0 = the access is RAZ/WI).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEREN</name>
              <description>Debug error response enable: 1 = debugger accesses that violate the ITGU get an error response.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITGU_CFG</name>
          <description>ITCM Gate Unit Configuration Register: block size and count (read-only).</description>
          <addressOffset>0x504</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>BLKSZ</name>
              <description>Block size: 2^(BLKSZ+5) bytes per look-up-table bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>NUMBLKS</name>
              <description>Number of blocks: 2^NUMBLKS.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>ITGU present.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ITGU_LUT%s</name>
          <description>ITCM Gate Unit Look-Up Table n: bit k marks ITCM block 32n+k as Non-secure (0 = Secure).</description>
          <addressOffset>0x510</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>LUT</name>
              <description>Bit k: ITCM block 32n+k is Non-secure (1) or Secure (0).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DTGU_CTRL</name>
          <description>DTCM Gate Unit Control Register: how DTGU security violations are reported.</description>
          <addressOffset>0x600</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>DBFEN</name>
              <description>Data bus fault enable: 1 = a DTGU security violation raises a BusFault/SecureFault (0 = the access is RAZ/WI).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEREN</name>
              <description>Debug error response enable: 1 = debugger accesses that violate the DTGU get an error response.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DTGU_CFG</name>
          <description>DTCM Gate Unit Configuration Register: block size and count (read-only).</description>
          <addressOffset>0x604</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>BLKSZ</name>
              <description>Block size: 2^(BLKSZ+5) bytes per look-up-table bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>NUMBLKS</name>
              <description>Number of blocks: 2^NUMBLKS.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>DTGU present.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>DTGU_LUT%s</name>
          <description>DTCM Gate Unit Look-Up Table n: bit k marks DTCM block 32n+k as Non-secure (0 = Secure).</description>
          <addressOffset>0x610</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>LUT</name>
              <description>Bit k: DTCM block 32n+k is Non-secure (1) or Secure (0).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>ERRBNK</name>
      <description>Error Bank: records the location of ECC errors detected in the instruction cache, data cache and (Cortex-M55/M85) TCM RAMs, so software can scrub the location and diagnose failing RAM.</description>
      <groupName>ErrBnk</groupName>
      <baseAddress>0xE001E100</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x030</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>IEBR0</name>
          <description>Instruction Cache Error Bank Register 0: the first recorded I-cache ECC error.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALID</name>
              <description>Entry valid: an error has been recorded. Clear it after scrubbing the location.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Locked: a further error occurred while this entry was valid; the entry keeps the first error until cleared.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCATION</name>
              <description>Location of the error inside the I-cache (set/way/word encoding, see the TRM).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
            </field>
            <field>
              <name>BANK</name>
              <description>RAM bank of the error.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWDEF</name>
              <description>Software-defined bits (not used by hardware).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IEBR1</name>
          <description>Instruction Cache Error Bank Register 1: the second recorded I-cache ECC error.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALID</name>
              <description>Entry valid: an error has been recorded. Clear it after scrubbing the location.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Locked: a further error occurred while this entry was valid; the entry keeps the first error until cleared.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCATION</name>
              <description>Location of the error inside the I-cache (set/way/word encoding, see the TRM).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
            </field>
            <field>
              <name>BANK</name>
              <description>RAM bank of the error.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWDEF</name>
              <description>Software-defined bits (not used by hardware).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEBR0</name>
          <description>Data Cache Error Bank Register 0: the first recorded D-cache ECC error.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALID</name>
              <description>Entry valid: an error has been recorded.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Locked: a further error occurred while this entry was valid; the entry keeps the first error until cleared.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCATION</name>
              <description>Location of the error inside the D-cache (set/way/word encoding, see the TRM).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
            </field>
            <field>
              <name>BANK</name>
              <description>RAM bank of the error.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TYPE</name>
              <description>Error type: 0 = data RAM, 1 = tag/dirty RAM.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWDEF</name>
              <description>Software-defined bits (not used by hardware).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEBR1</name>
          <description>Data Cache Error Bank Register 1: the second recorded D-cache ECC error.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALID</name>
              <description>Entry valid: an error has been recorded.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Locked: a further error occurred while this entry was valid; the entry keeps the first error until cleared.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCATION</name>
              <description>Location of the error inside the D-cache (set/way/word encoding, see the TRM).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
            </field>
            <field>
              <name>BANK</name>
              <description>RAM bank of the error.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TYPE</name>
              <description>Error type: 0 = data RAM, 1 = tag/dirty RAM.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWDEF</name>
              <description>Software-defined bits (not used by hardware).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TEBR0</name>
          <description>TCM Error Bank Register 0: the first recorded TCM ECC error.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALID</name>
              <description>Entry valid: an error has been recorded.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Locked: a further error occurred while this entry was valid.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCATION</name>
              <description>Word address of the error within the TCM.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>22</bitWidth>
            </field>
            <field>
              <name>BANK</name>
              <description>TCM bank: which of the ITCM/DTCM RAM banks the error was in.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>TYPE</name>
              <description>Error type: 0 = correctable (single-bit), 1 = uncorrectable (double-bit).</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>POISON</name>
              <description>1 = the location was poisoned (its data marked invalid) after an uncorrectable error.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWDEF</name>
              <description>Software-defined bits (not used by hardware).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TEBRDATA0</name>
          <description>Storage for corrected data that is associated with an error.</description>
          <addressOffset>0x024</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>TEBR1</name>
          <description>TCM Error Bank Register 1: the second recorded TCM ECC error.</description>
          <addressOffset>0x028</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALID</name>
              <description>Entry valid: an error has been recorded.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCKED</name>
              <description>Locked: a further error occurred while this entry was valid.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOCATION</name>
              <description>Word address of the error within the TCM.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>22</bitWidth>
            </field>
            <field>
              <name>BANK</name>
              <description>TCM bank: which of the ITCM/DTCM RAM banks the error was in.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>TYPE</name>
              <description>Error type: 0 = correctable (single-bit), 1 = uncorrectable (double-bit).</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>POISON</name>
              <description>1 = the location was poisoned (its data marked invalid) after an uncorrectable error.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWDEF</name>
              <description>Software-defined bits (not used by hardware).</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TEBRDATA1</name>
          <description>Storage for corrected data that is associated with an error.</description>
          <addressOffset>0x02C</addressOffset>
          <access>read-only</access>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DCAR</name>
      <description>Direct Cache Access Registers (Cortex-M52): read cache RAM contents by location for test and diagnostics.</description>
      <baseAddress>0xE001E200</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x018</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DCADCRR</name>
          <description>Direct Cache Access Data Cache Read Register: the data read from the D-cache location selected in DCADCLR.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>DCAICRR</name>
          <description>Direct Cache Access Instruction Cache Read Register: the data read from the I-cache location selected in DCAICLR.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>DCADCLR</name>
          <description>Direct Cache Access Data Cache Location Register: set, way and word of the D-cache entry to read.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>DCAICLR</name>
          <description>Direct Cache Access Instruction Cache Location Register: set, way and word of the I-cache entry to read.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PWRMODCTL</name>
      <description>Power Mode Control (Cortex-M55/M85/M52): the low-power state (ON / retention / OFF) requested for the core, EPU and RAM power domains when the processor sleeps.</description>
      <groupName>PwrModCtl</groupName>
      <baseAddress>0xE001E300</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CPDLPSTATE</name>
          <description>Core Power Domain Low Power State Register: the power state requested for the core, EPU (FPU/MVE) and RAM domains on deep sleep.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLPSTATE</name>
              <description>Core low-power state requested on deep sleep: 0 = ON, 1 = ON with the clock stopped, 2 = retention, 3 = OFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>RLPSTATE</name>
              <description>RAM (caches/TCM) low-power state: 0 = ON, 2 = retention, 3 = OFF.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DPDLPSTATE</name>
          <description>Debug Power Domain Low Power State Register: the power state requested for the debug domain.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>DLPSTATE</name>
              <description>Debug power domain low-power state: 0 = ON, 2 = retention, 3 = OFF.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>EWIC_ISA</name>
      <description>EWIC Interrupt Status Access: the processor-side view of the EWIC - set an event pending and read back the mask configuration.</description>
      <baseAddress>0xE001E400</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x080</offset>
        <size>0x040</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>EVENTSPR</name>
          <description>Event Set Pending Register: software writes to latch an event as if it had arrived.</description>
          <addressOffset>0x000</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>EVENT</name>
              <description>Write 1 to latch an EVENT.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NMI</name>
              <description>Write 1 to latch an NMI.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EDBGREQ</name>
              <description>Write 1 to latch an external debug request.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EVENTMASKA</name>
          <description>Event Mask A Register: read-only copy of EWIC_MASKA.</description>
          <addressOffset>0x080</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>EVENT</name>
              <description>Wake on EVENT is enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NMI</name>
              <description>Wake on NMI is enabled.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EDBGREQ</name>
              <description>Wake on external debug request is enabled.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>15</dim>
          <dimIncrement>0x4</dimIncrement>
          <dimIndex>1-15</dimIndex>
          <name>EVENTMASK%s</name>
          <description>Event Mask Register n: read-only copy of EWIC_MASKn.</description>
          <addressOffset>0x084</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>IRQ</name>
              <description>Bit k = 1: wake on IRQ 32(n-1)+k is enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PRCCFGINF</name>
      <description>Processor Configuration Information: indexed read access to the build-time configuration of the core (cache/TCM sizes, options).</description>
      <groupName>PrcCfgInf</groupName>
      <baseAddress>0xE001E700</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CFGINFOSEL</name>
          <description>Processor Configuration Information Selection Register: write the index of the configuration word to read from CFGINFORD.</description>
          <addressOffset>0x000</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>SEL</name>
              <description>Index of the configuration information word to read.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CFGINFORD</name>
          <description>Processor Configuration Information Read Data Register: the configuration word selected by CFGINFOSEL.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DATA</name>
              <description>Configuration information word.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>STL</name>
      <description>Software Test Library support registers (Cortex-M55/M85): expose internal NVIC priority-tree, MPU lookup, store buffer and line-fill state for functional-safety self test.</description>
      <baseAddress>0xE001E800</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x01C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>STLNVICPENDOR</name>
          <description>NVIC Pending Priority Tree Register: the output of the NVIC pending-priority tree (highest-priority pending interrupt).</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>INTNUM</name>
              <description>Interrupt number of the highest-priority pending interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>PRIORITY</name>
              <description>Its priority.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>TARGET</name>
              <description>Its target security state: 0 = Secure, 1 = Non-secure.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VALID</name>
              <description>1 = an interrupt is pending (the other fields are valid).</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STLNVICACTVOR</name>
          <description>NVIC Active Priority Tree Register: the output of the NVIC active-priority tree (highest-priority active interrupt).</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>INTNUM</name>
              <description>Interrupt number of the highest-priority active interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>PRIORITY</name>
              <description>Its priority.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>TARGET</name>
              <description>Its target security state: 0 = Secure, 1 = Non-secure.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VALID</name>
              <description>1 = an interrupt is active (the other fields are valid).</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STLIDMPUSR</name>
          <description>MPU Sample Register: write an address and side to perform a test MPU lookup whose results appear in STLIMPUOR / STLDnMPUOR.</description>
          <addressOffset>0x010</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>DATA</name>
              <description>Perform a data-side MPU lookup.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INSTR</name>
              <description>Perform an instruction-side MPU lookup.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR</name>
              <description>Address to look up, bits [31:5].</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STLIMPUOR</name>
          <description>MPU Region Hit Register: instruction-side result of the STLIDMPUSR lookup.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATTR</name>
              <description>Attributes returned by the instruction-side lookup.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>HITREGION</name>
              <description>Region number that matched (instruction side).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STLDMPUOR</name>
          <description>MPU Memory Attributes Register: data-side result of the STLIDMPUSR lookup.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATTR</name>
              <description>Attributes returned by the data-side lookup.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>HITREGION</name>
              <description>Region number that matched (data side).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="ICB">
      <name>ICB_NS</name>
      <description>Non-secure alias of ICB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002E000</baseAddress>
    </peripheral>
    <peripheral derivedFrom="SysTick">
      <name>SysTick_NS</name>
      <description>Non-secure alias of SysTick at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002E010</baseAddress>
    </peripheral>
    <peripheral derivedFrom="NVIC">
      <name>NVIC_NS</name>
      <description>Non-secure alias of NVIC at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002E100</baseAddress>
    </peripheral>
    <peripheral derivedFrom="SCB">
      <name>SCB_NS</name>
      <description>Non-secure alias of SCB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002ED00</baseAddress>
    </peripheral>
    <peripheral derivedFrom="MPU">
      <name>MPU_NS</name>
      <description>Non-secure alias of MPU at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002ED90</baseAddress>
    </peripheral>
    <peripheral derivedFrom="DCB">
      <name>DCB_NS</name>
      <description>Non-secure alias of DCB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002EDF0</baseAddress>
    </peripheral>
    <peripheral derivedFrom="FPU">
      <name>FPU_NS</name>
      <description>Non-secure alias of FPU at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002EF30</baseAddress>
    </peripheral>
    <peripheral derivedFrom="DIB">
      <name>DIB_NS</name>
      <description>Non-secure alias of DIB at 0xE002xxxx (Security Extension only): the same registers as seen by Non-secure software, accessible from Secure state or a debugger for the Non-secure view.</description>
      <baseAddress>0xE002EFB0</baseAddress>
    </peripheral>
    <peripheral>
      <name>TPIU</name>
      <description>Trace Port Interface Unit: drives the ITM/DWT/ETM trace out through the parallel trace port or the single-wire SWO pin (Manchester or UART/NRZ). ACPR sets the SWO baud rate, SPPR the pin protocol, FFCR the formatter.</description>
      <baseAddress>0xE0040000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x014</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x0F0</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x300</offset>
        <size>0x00C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xEE8</offset>
        <size>0x01C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFA0</offset>
        <size>0x060</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SSPSR</name>
          <description>Supported Parallel Port Size Register: bit n-1 set = a trace port width of n bits is supported. Read-only.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SWIDTH</name>
              <description>Bit n-1 set = a trace port width of n bits is supported.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CSPSR</name>
          <description>Current Parallel Port Size Register: one-hot, bit n-1 = width n; must be 1 (bit 0) for SWO.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CWIDTH</name>
              <description>One-hot current port width: bit n-1 = n bits. 1 = single-bit (SWO).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ACPR</name>
          <description>Asynchronous Clock Prescaler Register: SWO baud rate = TRACECLKIN / (PRESCALER + 1).</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRESCALER</name>
              <description>SWO clock divider: baud rate = TRACECLKIN / (PRESCALER + 1). For example 4 MHz SWO from 200 MHz: PRESCALER = 49.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SPPR</name>
          <description>Selected Pin Protocol Register: parallel trace port, SWO Manchester or SWO NRZ (UART).</description>
          <addressOffset>0x0F0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TXMODE</name>
              <description>Pin protocol: 0 = parallel trace port, 1 = SWO Manchester, 2 = SWO NRZ (UART-like, the common choice), 3 = reserved.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Parallel</name>
                  <description>Parallel trace port</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWO_Manchester</name>
                  <description>Serial wire output, Manchester encoding</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWO_NRZ</name>
                  <description>Serial wire output, NRZ (UART) encoding</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FFSR</name>
          <description>Formatter and Flush Status Register.</description>
          <addressOffset>0x300</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>FlInProg</name>
              <description>Flush in progress.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FtStopped</name>
              <description>Formatter stopped (RAZ on cores whose formatter cannot stop).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TCPresent</name>
              <description>TRACECTL pin present: 1 = the trace port has a TRACECTL signal.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FtNonStop</name>
              <description>Formatter cannot be stopped (reads 1).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FFCR</name>
          <description>Formatter and Flush Control Register: enable continuous formatting (needed when the ETM and ITM share the port), manual flush, trigger indication.</description>
          <addressOffset>0x304</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EnFCont</name>
              <description>Enable continuous formatting: 1 = frames are always formatted with source IDs (required when the ETM and ITM share the trace port; must be 0 for ITM-only SWO to get raw ITM packets).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FOnMan</name>
              <description>Manual flush: write 1 to flush the formatter FIFO now.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TrigIn</name>
              <description>Indicate a trigger on the TRIGIN input in the formatted stream (reads 1).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PSCR</name>
          <description>Periodic Synchronization Control Register: how often the formatter inserts synchronization packets.</description>
          <addressOffset>0x308</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PSCount</name>
              <description>Periodic synchronization: 0 = disabled; else a synchronization sequence is inserted every 2^PSCount bytes (minimum 7 = 128 bytes).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TRIGGER</name>
          <description>Integration register: the current state of the TRIGIN input.</description>
          <addressOffset>0xEE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TRIGGER</name>
              <description>Current state of the TRIGIN input.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITFTTD0</name>
          <description>Integration Test FIFO Test Data 0: ATB interface 1 (ETM) data bytes and handshake flags (integration mode).</description>
          <addressOffset>0xEEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATB_IF1_data0</name>
              <description>ATB interface 1 data byte 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_data1</name>
              <description>ATB interface 1 data byte 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_data2</name>
              <description>ATB interface 1 data byte 2.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_bytecount</name>
              <description>ATB interface 1 valid bytes - 1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_ATVALID</name>
              <description>ATB interface 1 ATVALID.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_bytecount</name>
              <description>ATB interface 2 valid bytes - 1.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_ATVALID</name>
              <description>ATB interface 2 ATVALID.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR2</name>
          <description>Integration Test ATB Control 2: ATREADY/AFVALID outputs to the ATB masters (integration mode).</description>
          <addressOffset>0xEF0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ATREADY1S</name>
              <description>ATB interface 1 ATREADY (integration).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AFVALID1S</name>
              <description>ATB interface 1 AFVALID (integration).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR0</name>
          <description>Integration Test ATB Control 0: ATVALID/AFREADY inputs from the ATB masters (integration mode).</description>
          <addressOffset>0xEF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATREADY1S</name>
              <description>ATB interface 1 ATREADY (integration).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AFVALID1S</name>
              <description>ATB interface 1 AFVALID (integration).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITFTTD1</name>
          <description>Integration Test FIFO Test Data 1: ATB interface 2 (ITM) data bytes and handshake flags (integration mode).</description>
          <addressOffset>0xEFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ATB_IF2_data0</name>
              <description>ATB interface 2 data byte 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_data1</name>
              <description>ATB interface 2 data byte 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_data2</name>
              <description>ATB interface 2 data byte 2.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_bytecount</name>
              <description>ATB interface 1 valid bytes - 1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF1_ATVALID</name>
              <description>ATB interface 1 ATVALID.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_bytecount</name>
              <description>ATB interface 2 valid bytes - 1.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ATB_IF2_ATVALID</name>
              <description>ATB interface 2 ATVALID.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ITCTRL</name>
          <description>Integration Mode Control Register.</description>
          <addressOffset>0xF00</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>Mode</name>
              <description>Integration mode: 0 = normal operation, 1 = integration test mode (the IT* registers drive/observe the ATB and trace port).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMSET</name>
          <description>Claim Tag Set Register: read = which claim bits are implemented, write 1 = set a claim bit. Lets a debugger and software signal ownership of the TPIU.</description>
          <addressOffset>0xFA0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SET</name>
              <description>Read: 1 = claim bit implemented; write 1 = set the claim bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMCLR</name>
          <description>Claim Tag Clear Register: read = current claim tag, write 1 = clear a bit.</description>
          <addressOffset>0xFA4</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CLR</name>
              <description>Read: current claim tag; write 1 = clear the claim bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVID</name>
          <description>Device Configuration Register: number of trace inputs, FIFO size and which pin protocols are supported. Read-only.</description>
          <addressOffset>0xFC8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NrTraceInput</name>
              <description>Number of ATB trace inputs (implementation-defined encoding, see the core TRM; Cortex-M cores with an ETM have two: ETM and ITM).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>FIFOSZ</name>
              <description>Formatter FIFO size, log2 of the number of words (2 = 4 words on Cortex-M33/M55).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PTINVALID</name>
              <description>1 = the parallel trace port is NOT supported (SWO only).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MANCVALID</name>
              <description>1 = SWO Manchester encoding is supported.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NRZVALID</name>
              <description>1 = SWO NRZ (UART) encoding is supported.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: 0x11 (trace sink, trace port). Read-only.</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MajorType</name>
              <description>Major type: 1 = trace sink.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SubType</name>
              <description>Sub type: 1 = trace port (TPIU).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CTI</name>
      <description>Cross Trigger Interface (CoreSight CTI, optional): routes debug events (halt, restart, DWT/ETM triggers) between the core and the rest of the SoC over four cross-trigger channels. Cortex-M33/M55/M85 implement 8 triggers in and out.</description>
      <baseAddress>0xE0042000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x040</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x0A0</offset>
        <size>0x020</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x130</offset>
        <size>0x018</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xEE4</offset>
        <size>0x020</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFA0</offset>
        <size>0x060</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTICONTROL</name>
          <description>CTI Control Register.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>GLBEN</name>
              <description>Global enable: 1 = the CTI passes trigger events to and from the channels.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIINTACK</name>
          <description>CTI Interrupt Acknowledge Register: write 1 to clear an active trigger output (needed for level-sensitive outputs such as the debug request).</description>
          <addressOffset>0x010</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>INTACK</name>
              <description>Bit n acknowledges trigger output n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIAPPSET</name>
          <description>CTI Application Trigger Set Register: software-generated channel events.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>APPSET</name>
              <description>Write 1 to bit n to raise an event on channel n; reads the current application trigger state.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIAPPCLEAR</name>
          <description>CTI Application Trigger Clear Register.</description>
          <addressOffset>0x018</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>APPCLEAR</name>
              <description>Write 1 to bit n to clear the application trigger on channel n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIAPPPULSE</name>
          <description>CTI Application Pulse Register: one-cycle channel event.</description>
          <addressOffset>0x01C</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>APPULSE</name>
              <description>Write 1 to bit n to pulse channel n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>CTIINEN%s</name>
          <description>CTI Trigger to Channel Enable Register n: which channels trigger input n drives. Cortex-M trigger inputs: 0 core halted, 1 DWT comparator 0, 2 DWT comparator 1, 3 DWT comparator 2, 4 ETM event 0, 5 ETM event 1, 6-7 implementation defined.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TRIGINEN</name>
              <description>Bit k: trigger input n generates an event on channel k.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>CTIOUTEN%s</name>
          <description>CTI Channel to Trigger Enable Register n: which channels drive trigger output n. Cortex-M trigger outputs: 0 debug request (halt), 1 restart, 2-3 CTI interrupts, 4-7 ETM external inputs / implementation defined.</description>
          <addressOffset>0x0A0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>TRIGOUTEN</name>
              <description>Bit k: an event on channel k asserts trigger output n.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTITRIGINSTATUS</name>
          <description>CTI Trigger In Status Register.</description>
          <addressOffset>0x130</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TRIGINSTATUS</name>
              <description>Bit n: trigger input n is asserted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTITRIGOUTSTATUS</name>
          <description>CTI Trigger Out Status Register.</description>
          <addressOffset>0x134</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>TRIGOUTSTATUS</name>
              <description>Bit n: trigger output n is asserted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTICHINSTATUS</name>
          <description>CTI Channel In Status Register.</description>
          <addressOffset>0x138</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CTICHINSTATUS</name>
              <description>Bit k: channel k input is active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTICHOUTSTATUS</name>
          <description>CTI Channel Out Status Register.</description>
          <addressOffset>0x13C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CTICHOUTSTATUS</name>
              <description>Bit k: channel k output is active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTIGATE</name>
          <description>CTI Channel Gate Enable Register: which channels propagate to the external cross-trigger matrix. Reset value 0xF (all open).</description>
          <addressOffset>0x140</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CTIGATEEN</name>
              <description>Bit k: 1 = channel k events pass to/from the CTM, 0 = channel k is internal to this CTI.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ASICCTL</name>
          <description>External Multiplexer Control Register (implementation defined; reserved on Cortex-M).</description>
          <addressOffset>0x144</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>ITCHOUT</name>
          <description>Integration Test Channel Output Register (integration mode only).</description>
          <addressOffset>0xEE4</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>ITTRIGOUT</name>
          <description>Integration Test Trigger Output Register (integration mode only).</description>
          <addressOffset>0xEE8</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>ITCHIN</name>
          <description>Integration Test Channel Input Register (integration mode only).</description>
          <addressOffset>0xEF4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ITTRIGIN</name>
          <description>Integration Test Trigger Input Register (integration mode only).</description>
          <addressOffset>0xEF8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ITCTRL</name>
          <description>Integration Mode Control Register.</description>
          <addressOffset>0xF00</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IME</name>
              <description>Integration mode enable: 1 = the IT* registers drive and observe the CTI ports.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMSET</name>
          <description>Claim Tag Set Register: reads the implemented claim bits (1 = implemented), write 1 to set a claim bit. Used by debuggers and software to negotiate ownership.</description>
          <addressOffset>0xFA0</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>CLAIMCLR</name>
          <description>Claim Tag Clear Register: reads the current claim tag, write 1 to clear a claim bit.</description>
          <addressOffset>0xFA4</addressOffset>
          <access>read-write</access>
        </register>
        <register>
          <name>DEVAFF0</name>
          <description>Device Affinity Register 0 (implementation defined).</description>
          <addressOffset>0xFA8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>DEVAFF1</name>
          <description>Device Affinity Register 1 (implementation defined).</description>
          <addressOffset>0xFAC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>LAR</name>
          <description>Lock Access Register: write 0xC5ACCE55 to unlock the component for software (not debugger) writes.</description>
          <addressOffset>0xFB0</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>Write 0xC5ACCE55 to unlock, any other value to lock.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LSR</name>
          <description>Lock Status Register.</description>
          <addressOffset>0xFB4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>SLI</name>
              <description>Software lock implemented.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLK</name>
              <description>Software lock status: 1 = locked, writes from software are ignored.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>nTT</name>
              <description>Not thirty-two bit: 0 = the lock register is 32-bit.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AUTHSTATUS</name>
          <description>Authentication Status Register: which debug and trace features the DAUTH/SPIDEN inputs currently permit.</description>
          <addressOffset>0xFB8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NSID</name>
              <description>Non-secure invasive debug: 0b10 disabled, 0b11 enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>NSNID</name>
              <description>Non-secure non-invasive debug.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SID</name>
              <description>Secure invasive debug.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SNID</name>
              <description>Secure non-invasive debug.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVARCH</name>
          <description>Device Architecture Register: the architecture of the component (CoreSight ARCHID) and its architect.</description>
          <addressOffset>0xFBC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ARCHID</name>
              <description>Architecture ID, including the architecture part number [11:0] and revision [15:12].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect (Arm: 0x23B).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVID2</name>
          <description>Device Configuration Register 2 (reserved).</description>
          <addressOffset>0xFC0</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>DEVID1</name>
          <description>Device Configuration Register 1 (reserved).</description>
          <addressOffset>0xFC4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>DEVID</name>
          <description>Device Configuration Register: CTI topology.</description>
          <addressOffset>0xFC8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>EXTMUXNUM</name>
              <description>Number of multiplexers on the trigger inputs and outputs (0 on Cortex-M).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>NUMTRIG</name>
              <description>Number of triggers implemented.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>NUMCH</name>
              <description>Number of channels implemented.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>INOUT</name>
              <description>Input/output options: 0 = no CTIGATE mask on CTM.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: major and sub type of the CoreSight component.</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 miscellaneous, 1 trace sink, 2 trace link, 3 trace source, 4 debug control, 5 debug logic, 6 PMU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type within the major class.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>EWIC</name>
      <description>External Wakeup Interrupt Controller: latches interrupt, NMI and event inputs while the processor is powered down and wakes it. Configure the masks before sleeping.</description>
      <baseAddress>0xE0047000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x010</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x200</offset>
        <size>0x040</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x400</offset>
        <size>0x040</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x600</offset>
        <size>0x004</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>EWIC_CR</name>
          <description>EWIC Control Register: global enable.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EN</name>
              <description>EWIC enable. Set before powering down so wake-up events are latched.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EWIC_ASCR</name>
          <description>EWIC Automatic Sequence Control Register: automatic mask/unmask sequencing on power-down and power-up.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ASPD</name>
              <description>Automatic sequence on power-down: 1 = the EWIC copies the NVIC enables into its masks automatically when the processor powers down.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ASPU</name>
              <description>Automatic sequence on power-up: 1 = latched events are transferred to the NVIC automatically on power-up.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EWIC_CLRMASK</name>
          <description>EWIC Clear Mask Register: write to clear all mask registers.</description>
          <addressOffset>0x008</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>CLRMASK</name>
              <description>Write to clear all EWIC mask registers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EWIC_NUMID</name>
          <description>EWIC Event Number ID Register: how many events (interrupts plus NMI/EVENT/EDBGREQ) the EWIC handles.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NUMEVENT</name>
              <description>Number of events supported.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EWIC_MASKA</name>
          <description>EWIC Mask A Register: wake-up enables for the non-interrupt events (EVENT, NMI, EDBGREQ).</description>
          <addressOffset>0x200</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EVENT</name>
              <description>Wake on the EVENT (RXEV) input.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NMI</name>
              <description>Wake on NMI.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EDBGREQ</name>
              <description>Wake on an external debug request.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>15</dim>
          <dimIncrement>0x4</dimIncrement>
          <dimIndex>1-15</dimIndex>
          <name>EWIC_MASK%s</name>
          <description>EWIC Mask Register n: bit k enables wake-up on IRQ 32(n-1)+k.</description>
          <addressOffset>0x204</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IRQ</name>
              <description>Bit k = 1: wake on IRQ 32(n-1)+k.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EWIC_PENDA</name>
          <description>EWIC Pend A Register: which non-interrupt events have been latched.</description>
          <addressOffset>0x400</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>EVENT</name>
              <description>EVENT input was latched.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NMI</name>
              <description>NMI was latched.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EDBGREQ</name>
              <description>External debug request was latched.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>15</dim>
          <dimIncrement>0x4</dimIncrement>
          <dimIndex>1-15</dimIndex>
          <name>EWIC_PEND%s</name>
          <description>EWIC Pend Register n: bit k = IRQ 32(n-1)+k has been latched while the processor was powered down.</description>
          <addressOffset>0x404</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>IRQ</name>
              <description>Bit k = 1: IRQ 32(n-1)+k was latched.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EWIC_PSR</name>
          <description>EWIC Pend Summary Register: which PEND registers hold at least one latched event.</description>
          <addressOffset>0x600</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>NZA</name>
              <description>EWIC_PENDA is non-zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NZ</name>
              <description>Bit n-1 = 1: EWIC_PENDn is non-zero.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>15</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>

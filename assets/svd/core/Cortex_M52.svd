        <register>
          <name>COMP7</name>
          <description>Comparator Register 7</description>
          <addressOffset>0x090</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>COMP</name>
              <description>Reference value for the comparator: an address, a data value (DATAVMATCH / MATCH = data value) or a cycle count.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FUNCTION7</name>
          <description>Function Register 7</description>
          <addressOffset>0x098</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>MATCH</name>
              <description>ARMv8-M match type: 0 disabled, 1 cycle counter (comparator 0), 2 instruction address, 3 instruction address limit (with the previous comparator forms a range), 4 data address, 5 data address limit, 6 data address with data value (linked to the next comparator), 7 data address limit with value, 8 data value, 9 data address linked (for the value in the next comparator), 10 data address with value linked, 11-15 further data-value/range combinations. See the ARMv8-M ARM DWT_FUNCTION table and ID for what this comparator supports.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ACTION</name>
              <description>Action on match: 0 = trigger only (CMPMATCH to ETM/CTI), 1 = debug event (halt, or DebugMonitor), 2 = data trace packet (address/PC/value), 3 = both trace and trigger.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>CMPMATCH trigger only</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DebugEvent</name>
                  <description>Watchpoint debug event</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trace</name>
                  <description>Data trace packet</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TraceTrigger</name>
                  <description>Trace and trigger</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATAVSIZE</name>
              <description>Size of the data value to match: 0 = byte, 1 = halfword, 2 = word.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>MATCHED</name>
              <description>The comparator matched since this register was last read. Cleared on read.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ID</name>
              <description>Read-only capability ID of this comparator: which MATCH types (cycle counter, instruction address, data address, data value, linked/limit) it supports - see the DWT_FUNCTION.ID table in the ARMv8-M ARM.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVARCH</name>
          <description>Device Architecture Register: CoreSight ARCHID of the DWT (0x1A02).</description>
          <addressOffset>0xFBC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ARCHID</name>
              <description>Architecture ID, including the architecture part number [11:0] and revision [15:12].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Architecture revision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PRESENT</name>
              <description>1 = DEVARCH is present and its contents are valid.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARCHITECT</name>
              <description>JEP106 code of the architect (Arm: 0x23B).</description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Register: 0x00 (miscellaneous).</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major type: 0 miscellaneous, 1 trace sink, 2 trace link, 3 trace source, 4 debug control, 5 debug logic, 6 PMU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Sub type within the major class.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>

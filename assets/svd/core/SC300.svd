              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RASR_A2</name>
          <description>Alias of RASR that accesses region RNR+2. Same fields as RASR.</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Region enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Region size = 2^(SIZE+1) bytes: 4 = 32 B (minimum), 7 = 256 B, 11 = 4 KB, 19 = 1 MB, 31 = 4 GB.</description>
              <bitOffset>1</bitOffset>

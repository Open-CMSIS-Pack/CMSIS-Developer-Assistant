              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>B</name>
              <description>Bufferable (with C and TEX selects the memory type: TEX=0 C=0 B=0 Strongly-ordered, B=1 Device; C=1 B=0 write-through, C=1 B=1 write-back).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>C</name>
              <description>Cacheable (see B).</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S</name>
              <description>Shareable: 1 = the region is shared with other bus masters (DMA) - cacheable shared memory is treated as non-cacheable on Cortex-M7 unless CACR.SIWT is set.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TEX</name>
              <description>Type extension: 0 = standard types via C/B, 1 with C=B=0 Normal non-cacheable, 1 with C=B=1 write-back write-allocate, 2 = Device non-shareable, 4-7 = separate outer/inner cache policies in TEX[1:0] and C/B.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>AP</name>
              <description>Access permissions (privileged/unprivileged): 0 = no access, 1 = RW/no access, 2 = RW/RO, 3 = RW/RW, 5 = RO/no access, 6 or 7 = RO/RO.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoAccess</name>
                  <description>No access</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PrivRW</name>
                  <description>Privileged read/write, unprivileged no access</description>
                  <value>1</value>
                </enumeratedValue>

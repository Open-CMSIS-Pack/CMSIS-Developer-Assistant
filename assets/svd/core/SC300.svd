  <cpu>
    <name>SC300</name>
    <revision>r0p0</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>8</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>ITM</name>
      <description>Instrumentation Trace Macrocell: 32 stimulus ports that software writes to emit printf-style trace over SWO/TPIU, plus timestamps and the DWT event/PC-sample packets. Needs DEMCR.TRCENA = 1, an unlocked LAR on ARMv7-M, TCR.ITMENA and the port enabled in TER.</description>
      <baseAddress>0xE0000000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x080</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xE00</offset>
        <size>0x084</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFB0</offset>
        <size>0x050</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>32</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>STIM%s</name>
          <description>Stimulus Port n: a write emits an 8/16/32-bit software trace packet on port n (if enabled in TER). Reads return FIFOREADY, so software can wait for space.</description>
          <addressOffset>0x000</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>FIFOREADY</name>
              <description>Read: 1 = the stimulus port can accept a write (FIFO not full), 0 = wait.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TER</name>
          <description>Trace Enable Register: bit k enables stimulus port k. Privileged access only.</description>
          <addressOffset>0xE00</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>STIMENA</name>
              <description>Bit k: stimulus port 32n+k enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TPR</name>
          <description>Trace Privilege Register: which stimulus ports unprivileged code may write.</description>
          <addressOffset>0xE40</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRIVMASK</name>
              <description>Bit k = 1: stimulus port group k is privileged-only (unprivileged writes are ignored). ARMv7-M: 4 groups of 8 ports; ARMv8-M: one bit per port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TCR</name>
          <description>Trace Control Register: ITM enable, timestamps, synchronization, DWT packet forwarding and the ATB source ID.</description>
          <addressOffset>0xE80</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ITMENA</name>
              <description>ITM enable. Clear before reconfiguring; wait for BUSY = 0 before disabling.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSENA</name>
              <description>Local timestamp packets enable: a delta timestamp follows each group of packets.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYNCENA</name>
              <description>Synchronization packets enable (rate from DWT.CTRL.SYNCTAP). Needed for the receiver to recover framing.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DWTENA</name>
              <description>Enable forwarding of DWT hardware event packets (PC samples, watchpoints, exception trace, counters) through the ITM (TXENA on ARMv8-M).</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWOENA</name>
              <description>Timestamp clock: 1 = the local timestamp counter runs from the (asynchronous) SWO clock, 0 = from the processor clock. Set with TSENA in SWO mode.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TSPRESCALE</name>
              <description>Local timestamp prescaler: 0 = none, 1 = divide by 4, 2 = by 16, 3 = by 64.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No prescaling</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div4</name>
                  <description>Divide by 4</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div16</name>
                  <description>Divide by 16</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div64</name>
                  <description>Divide by 64</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GTSFREQ</name>
              <description>Global timestamp frequency: 0 = disabled, 1 = every 128 cycles, 2 = every 8192 cycles, 3 = after every packet when the trace bus is idle.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>TRACEBUSID</name>
              <description>ATB source ID of the ITM (must be unique and non-zero; 1 is conventional). The TPIU formatter tags packets with it when several sources share the port.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>BUSY</name>
              <description>Read-only: 1 = the ITM is still processing events. Wait for 0 before disabling or changing the configuration.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LAR</name>
          <description>Lock Access Register: software must write 0xC5ACCE55 here before writing any other ITM register (ARMv7-M). Debugger accesses are never locked.</description>
          <addressOffset>0xFB0</addressOffset>
          <access>write-only</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>Write 0xC5ACCE55 to unlock the ITM registers for software writes; any other value locks them.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LSR</name>
          <description>Lock Status Register: whether the ITM registers are locked against software writes.</description>
          <addressOffset>0xFB4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRESENT</name>
              <description>Software lock implemented (1 on ARMv7-M cores).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACCESS</name>
              <description>Lock status: 1 = locked, software writes to the ITM are ignored until 0xC5ACCE55 is written to LAR.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BYTEACC</name>
              <description>0 = the lock register is accessed as a 32-bit word.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR4</name>
          <description>Peripheral Identification Register 4: JEP106 continuation code and component size.</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEP106 continuation code of the designer (Arm: 0x4).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>SIZE</name>
              <description>Log2 of the number of 4 KB blocks the component occupies (0 = one block).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR5</name>
          <description>Peripheral Identification Register 5 (reserved, reads as zero).</description>
          <addressOffset>0xFD4</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR6</name>
          <description>Peripheral Identification Register 6 (reserved, reads as zero).</description>
          <addressOffset>0xFD8</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR7</name>
          <description>Peripheral Identification Register 7 (reserved, reads as zero).</description>
          <addressOffset>0xFDC</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>PIDR0</name>
          <description>Peripheral Identification Register 0: part number bits [7:0].</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Part number bits [7:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR1</name>
          <description>Peripheral Identification Register 1: part number bits [11:8] and designer bits [3:0].</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Part number bits [11:8].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DES_0</name>
              <description>JEP106 identity code bits [3:0] of the designer.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral Identification Register 2: designer bits [6:4], JEDEC flag and revision.</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>DES_1</name>
              <description>JEP106 identity code bits [6:4] of the designer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always 1: the designer ID is a JEDEC JEP106 code.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>REVISION</name>
              <description>Component major revision.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR3</name>
          <description>Peripheral Identification Register 3: customer modified and minor revision.</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Customer Modified: 0 if the component has not been modified by the integrator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>REVAND</name>
              <description>Minor revision (metal fix) number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR0</name>
          <description>Component Identification Register 0: preamble byte 0 (0x0D).</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Preamble, reads as 0x0D.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR1</name>
          <description>Component Identification Register 1: component class and preamble.</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Preamble, reads as 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLASS</name>
              <description>Component class: 0x1 ROM table, 0x9 CoreSight component, 0xE generic IP, 0xF CoreLink/PrimeCell.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR2</name>
          <description>Component Identification Register 2: preamble byte 2 (0x05).</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Preamble, reads as 0x05.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CIDR3</name>
          <description>Component Identification Register 3: preamble byte 3 (0xB1).</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Preamble, reads as 0xB1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DWT</name>
      <description>Data Watchpoint and Trace unit: cycle counter and profiling counters, PC sampling, exception trace, and address/data comparators that raise watchpoints (halt or DebugMonitor), trigger the ETM/CTI or emit data trace. Needs DEMCR.TRCENA = 1.</description>
      <baseAddress>0xE0001000</baseAddress>
      <addressBlock>
        <offset>0x000</offset>
        <size>0x05C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFD0</offset>
        <size>0x030</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>DWT Control Register: cycle counter, PC sampling, exception trace and profiling event enables; read-only capability bits (NUMCOMP, NOCYCCNT...) in the top byte.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CYCCNTENA</name>
              <description>Cycle counter enable: 1 = CYCCNT counts (DEMCR.TRCENA must be 1). Reset value 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>POSTPRESET</name>
              <description>Reload value for the POSTCNT down-counter that divides the CYCTAP rate for PC sampling and CYCEVT events (0 = every tap).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>POSTINIT</name>
              <description>Initial value of POSTCNT.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CYCTAP</name>
              <description>CYCCNT tap that decrements POSTCNT: 0 = bit 6 (every 64 cycles), 1 = bit 10 (every 1024 cycles).</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYNCTAP</name>
              <description>Synchronization packet interval (with TCR.SYNCENA): 0 = disabled, 1 = every 2^24 cycles (CYCCNT bit 24), 2 = 2^26, 3 = 2^28.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>PCSAMPLENA</name>
              <description>Periodic PC sample packets enable: a PC sample is emitted through the ITM every POSTCNT underflow (statistical profiling over SWO).</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCTRCENA</name>
              <description>Exception trace enable: emit packets on every exception entry, exit and return.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CPIEVTENA</name>
              <description>Enable the CPI counter overflow event packet.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCEVTENA</name>
              <description>Enable the exception overhead counter overflow event packet.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPEVTENA</name>
              <description>Enable the sleep counter overflow event packet.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSUEVTENA</name>
              <description>Enable the LSU counter overflow event packet.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FOLDEVTENA</name>
              <description>Enable the folded-instruction counter overflow event packet.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CYCEVTENA</name>
              <description>Enable the POSTCNT underflow (cycle count) event packet.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>NOPRFCNT</name>
              <description>1 = the profiling counters (CPICNT, EXCCNT, SLEEPCNT, LSUCNT, FOLDCNT) are not implemented. Read-only.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NOCYCCNT</name>
              <description>1 = CYCCNT is not implemented. Read-only.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NOEXTTRIG</name>
              <description>1 = the CMPMATCH trigger outputs are not implemented. Read-only.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NOTRCPKT</name>
              <description>1 = trace sampling and exception tracing (PC samples, data trace, exception trace) are not implemented. Read-only.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NUMCOMP</name>
              <description>Number of comparators implemented (0-15; 4 on most Cortex-M3/M4/M7/M33 devices). Read-only.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CYCCNT</name>
          <description>Cycle Count Register: counts processor clock cycles while CTRL.CYCCNTENA = 1 (and DEMCR.TRCENA), wrapping at 2^32. Read for cycle-accurate timing; write to reset.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CYCCNT</name>
              <description>Cycle count. Writable; write 0 to restart a measurement.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CPICNT</name>
          <description>CPI Count Register: extra cycles (beyond the first) of every instruction, 8-bit, generating a CPI event on overflow when CTRL.CPIEVTENA is set.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CPICNT</name>
              <description>Current CPI count (extra cycles per instruction), wraps at 256 with an event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EXCCNT</name>
          <description>Exception Overhead Count Register: cycles spent in exception entry and exit, 8-bit, event on overflow.</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>EXCCNT</name>
              <description>Current exception overhead count, wraps at 256 with an event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SLEEPCNT</name>
          <description>Sleep Count Register: cycles spent sleeping, 8-bit, event on overflow.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>SLEEPCNT</name>
              <description>Current sleep cycle count, wraps at 256 with an event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LSUCNT</name>
          <description>LSU Count Register: extra cycles spent by load/store instructions, 8-bit, event on overflow.</description>
          <addressOffset>0x014</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>LSUCNT</name>
              <description>Current load/store extra-cycle count, wraps at 256 with an event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FOLDCNT</name>
          <description>Folded-instruction Count Register: instructions that took zero cycles (folded), 8-bit, event on overflow.</description>
          <addressOffset>0x018</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>FOLDCNT</name>
              <description>Current folded-instruction count, wraps at 256 with an event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PCSR</name>
          <description>Program Counter Sample Register: the address of a recently executed instruction - read repeatedly by a debugger for non-intrusive statistical profiling. 0xFFFFFFFF when halted.</description>
          <addressOffset>0x01C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>EIASAMPLE</name>
              <description>Sampled instruction address (0xFFFFFFFF when the processor is halted or PCSR is not implemented).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>COMP0</name>
          <description>Comparator Register 0</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>COMP</name>
              <description>Reference value for the comparator: an address, a data value (DATAVMATCH / MATCH = data value) or a cycle count.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MASK0</name>
          <description>Mask Register 0</description>
          <addressOffset>0x024</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>MASK</name>
              <description>Log2 of the number of low address bits ignored by the comparator (0 = exact match, 4 = 16-byte range ...). The maximum supported value is found by writing all ones and reading back.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FUNCTION0</name>
          <description>Function Register 0</description>
          <addressOffset>0x028</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>FUNCTION</name>
              <description>ARMv7-M comparator function: 0 disabled; 1 emit PC sample on match, 2 emit data value, 3 emit PC and data value; 4 watchpoint on instruction fetch (PC), 5 watchpoint on read, 6 watchpoint on write, 7 watchpoint on read or write; 8-15 ETM trigger / data trace variants. With CYCMATCH: 1 = event, 4 = watchpoint on cycle count match.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>EMITRANGE</name>
              <description>1 = emit data-trace address offset packets instead of the full address (data trace functions 1-3 and 12-15).</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CYCMATCH</name>
              <description>Comparator 0 only: 1 = compare CYCCNT against COMP0 instead of an address.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATAVMATCH</name>
              <description>1 = compare the data value of the access (COMPn) rather than the address; DATAVADDR0/1 select the comparators that match the address.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LNK1ENA</name>
              <description>Read-only: 1 = a second linked address comparator (DATAVADDR1) is supported for data value matching.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DATAVSIZE</name>
              <description>Size of the data value to match: 0 = byte, 1 = halfword, 2 = word.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DATAVADDR0</name>
              <description>Number of the comparator that supplies the address match for data-value matching (DATAVMATCH = 1).</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DATAVADDR1</name>
              <description>Number of the second linked address comparator (only if LNK1ENA = 1).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>MATCHED</name>
              <description>The comparator matched since this register was last read. Cleared on read.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>COMP1</name>
          <description>Comparator Register 1</description>

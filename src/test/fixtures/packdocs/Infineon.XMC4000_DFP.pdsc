        <debug svd="SVD/XMC4700.svd" />
        <memory id="IROM1" start="0x08000000" size="0x200000" startup="1" default="1" />
        <memory id="IROM2" start="0x0C000000" size="0x200000" startup="0" default="0" />  
        <memory id="IRAM1" start="0x20000000" size="0x3FFC0" init="0" default="1" />           
        <memory id="IRAM2" start="0x1FFE8000" size="0x18000" init="0" default="1" />       
        <algorithm name="Flash/XMC4800_2048.FLM" start="0x0C000000" size="0x100000" default="1" />
        <algorithm name="Flash/XMC4800c_2048.FLM" start="0x08000000" size="0x100000" default="1" />      
        <book name="Documents/Infineon-ReferenceManual_XMC4700_XMC4800-UM-v01_03-EN.pdf" title="XMC4700 Series Reference Manual" />

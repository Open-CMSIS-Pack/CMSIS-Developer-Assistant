// tsc settings for `npm run compile`, `check-types` and `watch`: the sources
// and unit tests under src/ are type-checked and compiled into out/, which the
// tests run. The shipped bundle in dist/ is built by esbuild.js, and scripts/
// has a tsconfig.json of its own.
{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": [
            "ES2022"
        ],
        "skipLibCheck": true,
        "sourceMap": true,
        "rootDir": ".",
        // src/debuggingExecutor.ts reads the version from package.json.
        "resolveJsonModule": true,
        "strict": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "out",
        "node_modules",
        "test/realboard"
    ]
}
